<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ajuste de botones de tier validation para expedientes:
         - Mostrar "Reiniciar la validación" solo si aplica a la etapa actual -->
    <template id="tier_validation_buttons_stage" inherit_id="base_tier_validation.tier_validation_buttons">
        <xpath expr="//button[@name='restart_validation']" position="attributes">
            <!-- En Odoo 18 este botón usa el atributo invisible (no modifiers) -->
            <attribute name="invisible">not can_restart_validation_stage or hide_reviews</attribute>
        </xpath>
        <xpath expr="//button[@name='request_validation']" position="attributes">
            <!-- Solicitar validación por etapa -->
            <attribute name="t-attf-invisible">not need_validation or stage_validation_status == 'rejected' or hide_reviews</attribute>
        </xpath>
    </template>

    <template id="tier_validation_label_stage" inherit_id="base_tier_validation.tier_validation_label">
        <xpath expr="//div[@role='alert' and contains(@class,'alert-warning')]" position="attributes">
            <attribute name="t-attf-invisible">stage_validation_status == 'validated' or hide_reviews or stage_validation_status == 'rejected' or not has_stage_reviews</attribute>
        </xpath>
        <xpath expr="//div[@role='alert' and contains(@class,'alert-success')]" position="attributes">
            <attribute name="t-attf-invisible">stage_validation_status != 'validated' or hide_reviews or not has_stage_reviews</attribute>
        </xpath>
        <xpath expr="//div[@role='alert' and contains(@class,'alert-danger')]" position="attributes">
            <attribute name="t-attf-invisible">stage_validation_status != 'rejected' or hide_reviews or not has_stage_reviews</attribute>
        </xpath>
    </template>

    <template id="tier_validation_reviews_stage" inherit_id="base_tier_validation.tier_validation_reviews">
        <xpath expr="//field[@name='review_ids']" position="attributes">
            <!-- Mostrar desplegable solo cuando hay revisiones de la etapa actual -->
            <attribute name="invisible">not has_stage_reviews</attribute>
            <!-- Filtrar por etapa actual para mantener lógica por etapa -->
            <attribute name="domain">[('stage_id', '=', stage_id)]</attribute>
        </xpath>
    </template>
</odoo>

