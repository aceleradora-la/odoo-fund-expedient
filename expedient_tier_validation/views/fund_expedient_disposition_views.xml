<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Tier Validation embebida para Disposición: el form vive dentro del expediente y no
        pasa por get_view del modelo. Agregamos un <header> con statusbar de la etapa
        (stage_id, related expediente) + botones de validación, replicando el patrón visual
        del expediente. Definiciones tier filtran por stage_id.
    -->
    <record id="view_fund_expedient_form_disposition_tier" model="ir.ui.view">
        <field name="name">fund.expedient.form.disposition.tier</field>
        <field name="model">fund.expedient</field>
        <field name="inherit_id" ref="fund_expedient.view_fund_expedient_form"/>
        <field name="arch" type="xml">
            <!-- Insertamos un <header> al inicio del form embebido de disposición -->
            <xpath expr="//field[@name='disposition_ids']/form" position="inside">
                <field name="need_validation" invisible="1"/>
                <field name="validation_status" invisible="1"/>
                <field name="can_review" invisible="1"/>
                <field name="hide_reviews" invisible="1"/>
                <field name="has_comment" invisible="1"/>
                <field name="next_review" invisible="1"/>
                <field name="tier_stage_locked" invisible="1"/>
                <field name="can_restart_validation_stage" invisible="1"/>
                <field name="expedient_stage_editable" invisible="1"/>
                <field name="stage_validation_status" invisible="1"/>
                <field name="has_stage_reviews" invisible="1"/>

                <div class="alert alert-warning mb-2" role="alert"
                     invisible="stage_validation_status == 'validated' or hide_reviews or stage_validation_status == 'rejected' or not has_stage_reviews">
                    <i class="fa fa-info-circle"/>
                    Esta disposición necesita ser aprobada.
                </div>
                <div class="alert alert-success mb-2" role="alert"
                     invisible="stage_validation_status != 'validated' or hide_reviews or not has_stage_reviews">
                    <i class="fa fa-thumbs-up"/>
                    Disposición aprobada.
                </div>
                <div class="alert alert-danger mb-2" role="alert"
                     invisible="stage_validation_status != 'rejected' or hide_reviews or not has_stage_reviews">
                    <i class="fa fa-thumbs-down"/>
                    Disposición rechazada.
                </div>

                <group string="Aprobaciones" name="disposition_tier_reviews">
                    <field name="review_ids" nolabel="1">
                        <list create="0" delete="0">
                            <field name="stage_id" optional="show"/>
                            <field name="status"/>
                            <field name="todo_by"/>
                            <field name="done_by" optional="show"/>
                            <field name="reviewed_date" optional="show"/>
                        </list>
                    </field>
                </group>
            </xpath>

            <!--
                Header al principio del form embebido. Lo agregamos como primer hijo
                usando position="inside" sobre el form. Odoo respeta el orden:
                colocamos el <header> antes que los <group> con position="before"
                sobre el primer grupo.
            -->
            <xpath expr="//field[@name='disposition_ids']/form/group[1]" position="before">
                <header>
                    <!-- Statusbar con el flujo del expediente (state es related al expediente),
                         para que el usuario vea visualmente en qué estado está el dossier
                         al que pertenece esta disposición. -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,purchases,to_approve,approved"
                           readonly="1"/>

                    <button name="action_tier_request_validation" type="object"
                            string="Solicitar aprobación"
                            class="btn-primary"
                            invisible="not need_validation or stage_validation_status == 'rejected' or hide_reviews or not expedient_stage_editable"/>
                    <button name="action_tier_validate" type="object"
                            string="Aprobar"
                            class="btn-success"
                            invisible="not can_review"/>
                    <button name="action_tier_reject" type="object"
                            string="Rechazar"
                            class="btn-danger"
                            invisible="not can_review"/>
                    <button name="action_tier_restart_validation" type="object"
                            string="Reiniciar validación"
                            class="btn-secondary"
                            invisible="not can_restart_validation_stage or hide_reviews or not expedient_stage_editable"
                            confirm="¿Reiniciar la validación de la etapa actual?"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
