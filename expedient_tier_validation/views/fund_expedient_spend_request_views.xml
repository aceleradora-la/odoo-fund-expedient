<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Tier Validation en SG: insertamos manualmente los botones (request / validate / reject /
        restart) y la "label" de estado, tanto en el form standalone (menú "Solicitudes de Gasto")
        como en el form embebido dentro del expediente.

        Motivo: base_tier_validation auto-inyecta sólo en /form/header/button[last()] + /form/sheet
        durante get_view; el embedded form no pasa por ese get_view y el standalone no tenía
        <header>. Pasamos a manual config y declaramos todo aquí (UX consistente).
    -->

    <!-- ===========================
         Standalone form (menú SG)
         =========================== -->
    <record id="view_fund_expedient_spend_request_form_tier" model="ir.ui.view">
        <field name="name">fund.expedient.spend.request.form.tier</field>
        <field name="model">fund.expedient.spend.request</field>
        <field name="inherit_id" ref="fund_expedient.view_fund_expedient_spend_request_form"/>
        <field name="arch" type="xml">
            <!-- Header con campos invisibles y botones de validación -->
            <xpath expr="//sheet" position="before">
                <header>
                    <field name="need_validation" invisible="1"/>
                    <field name="validation_status" invisible="1"/>
                    <field name="can_review" invisible="1"/>
                    <field name="hide_reviews" invisible="1"/>
                    <field name="has_comment" invisible="1"/>
                    <field name="next_review" invisible="1"/>
                    <field name="tier_stage_locked" invisible="1"/>
                    <field name="can_restart_validation_stage" invisible="1"/>
                    <field name="stage_validation_status" invisible="1"/>
                    <field name="has_stage_reviews" invisible="1"/>

                    <button name="request_validation" type="object"
                            string="Solicitar aprobación"
                            class="btn-primary"
                            invisible="not need_validation or stage_validation_status == 'rejected' or hide_reviews"/>
                    <button name="validate_tier" type="object"
                            string="Aprobar"
                            class="btn-success"
                            invisible="not can_review"/>
                    <button name="reject_tier" type="object"
                            string="Rechazar"
                            class="btn-danger"
                            invisible="not can_review"/>
                    <button name="restart_validation" type="object"
                            string="Reiniciar validación"
                            class="btn-secondary"
                            invisible="not can_restart_validation_stage or hide_reviews"
                            confirm="¿Reiniciar la validación de la fase actual?"/>
                </header>
            </xpath>

            <!-- Banner de estado (warning / success / danger) y página de revisiones -->
            <xpath expr="//sheet" position="inside">
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="stage_validation_status == 'validated' or hide_reviews or stage_validation_status == 'rejected' or not has_stage_reviews">
                    <i class="fa fa-info-circle"/>
                    Esta solicitud necesita ser aprobada.
                </div>
                <div class="alert alert-success mb-0" role="alert"
                     invisible="stage_validation_status != 'validated' or hide_reviews or not has_stage_reviews">
                    <i class="fa fa-thumbs-up"/>
                    La fase fue aprobada.
                </div>
                <div class="alert alert-danger mb-0" role="alert"
                     invisible="stage_validation_status != 'rejected' or hide_reviews or not has_stage_reviews">
                    <i class="fa fa-thumbs-down"/>
                    La fase fue rechazada.
                </div>

                <group string="Aprobaciones" name="tier_reviews">
                    <field name="review_ids" nolabel="1">
                        <list create="0" delete="0">
                            <field name="spend_phase" optional="show"/>
                            <field name="sequence" optional="show"/>
                            <field name="status"/>
                            <field name="todo_by"/>
                            <field name="done_by" optional="show"/>
                            <field name="reviewed_date" optional="show"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <!-- ===========================================
         Embedded form (dentro del expediente)
         =========================================== -->
    <record id="view_fund_expedient_form_sg_tier" model="ir.ui.view">
        <field name="name">fund.expedient.form.sg.embedded.tier</field>
        <field name="model">fund.expedient</field>
        <field name="inherit_id" ref="fund_expedient.view_fund_expedient_form"/>
        <field name="arch" type="xml">
            <!-- Botones tier al inicio del form embebido (antes del primer grupo) -->
            <xpath expr="//field[@name='spend_request_ids']/form/group[@name='sg_identification']" position="before">
                <field name="need_validation" invisible="1"/>
                <field name="validation_status" invisible="1"/>
                <field name="can_review" invisible="1"/>
                <field name="hide_reviews" invisible="1"/>
                <field name="has_comment" invisible="1"/>
                <field name="next_review" invisible="1"/>
                <field name="tier_stage_locked" invisible="1"/>
                <field name="can_restart_validation_stage" invisible="1"/>
                <field name="stage_validation_status" invisible="1"/>
                <field name="has_stage_reviews" invisible="1"/>

                <div class="o_button_bar mb-2">
                    <button name="request_validation" type="object"
                            string="Solicitar aprobación"
                            class="btn-primary"
                            invisible="not need_validation or stage_validation_status == 'rejected' or hide_reviews"/>
                    <button name="validate_tier" type="object"
                            string="Aprobar"
                            class="btn-success"
                            invisible="not can_review"/>
                    <button name="reject_tier" type="object"
                            string="Rechazar"
                            class="btn-danger"
                            invisible="not can_review"/>
                    <button name="restart_validation" type="object"
                            string="Reiniciar validación"
                            class="btn-secondary"
                            invisible="not can_restart_validation_stage or hide_reviews"
                            confirm="¿Reiniciar la validación de la fase actual?"/>
                </div>

                <div class="alert alert-warning mb-0" role="alert"
                     invisible="stage_validation_status == 'validated' or hide_reviews or stage_validation_status == 'rejected' or not has_stage_reviews">
                    <i class="fa fa-info-circle"/>
                    Esta solicitud necesita ser aprobada.
                </div>
                <div class="alert alert-success mb-0" role="alert"
                     invisible="stage_validation_status != 'validated' or hide_reviews or not has_stage_reviews">
                    <i class="fa fa-thumbs-up"/>
                    La fase fue aprobada.
                </div>
                <div class="alert alert-danger mb-0" role="alert"
                     invisible="stage_validation_status != 'rejected' or hide_reviews or not has_stage_reviews">
                    <i class="fa fa-thumbs-down"/>
                    La fase fue rechazada.
                </div>
            </xpath>

            <!-- Listado de revisiones al final del form embebido -->
            <xpath expr="//field[@name='spend_request_ids']/form" position="inside">
                <group string="Aprobaciones" name="tier_reviews_embedded">
                    <field name="review_ids" nolabel="1">
                        <list create="0" delete="0">
                            <field name="spend_phase"/>
                            <field name="status"/>
                            <field name="todo_by"/>
                            <field name="done_by" optional="show"/>
                            <field name="reviewed_date" optional="show"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
