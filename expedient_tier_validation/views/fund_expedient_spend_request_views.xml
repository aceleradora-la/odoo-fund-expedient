<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Tier Validation en SG: agregamos <header> con statusbar de la fase activa
        (preventiva o definitiva) y botones de validación, replicando el patrón visual
        del expediente. base_tier_validation no auto-inyecta aquí porque:
          - el form standalone no tenía <header> nativo
          - el form embebido en el expediente no pasa por get_view de SG
        Por eso _tier_validation_manual_config = True en el modelo y aquí declaramos todo.
    -->

    <!-- ===========================
         Standalone form (menú SG)
         =========================== -->
    <record id="view_fund_expedient_spend_request_form_tier" model="ir.ui.view">
        <field name="name">fund.expedient.spend.request.form.tier</field>
        <field name="model">fund.expedient.spend.request</field>
        <field name="inherit_id" ref="fund_expedient.view_fund_expedient_spend_request_form"/>
        <field name="arch" type="xml">
            <!--
                El form base ya define <header> con el botón "Imprimir SG". Aquí
                inyectamos los botones/statusbars del tier DENTRO de ese header
                (position="inside") para evitar que se generen dos <header>
                separados, que renderizaban los botones en dos filas.
            -->
            <xpath expr="//header" position="inside">
                <!-- Statusbars: muestran el flujo de cada fase. Visibilidad condicionada
                     para que el usuario vea solo la fase activa (preventiva o definitiva). -->
                <field name="preventiva_state" widget="statusbar"
                       statusbar_visible="draft,generated,approved"
                       invisible="spend_state == 'definitiva'"/>
                <field name="definitiva_state" widget="statusbar"
                       statusbar_visible="draft,generated,approved"
                       invisible="spend_state != 'definitiva'"/>

                <!-- Campos requeridos por la lógica de tier (invisibles) -->
                <field name="spend_state" invisible="1"/>
                <field name="need_validation" invisible="1"/>
                <field name="validation_status" invisible="1"/>
                <field name="can_review" invisible="1"/>
                <field name="hide_reviews" invisible="1"/>
                <field name="has_comment" invisible="1"/>
                <field name="next_review" invisible="1"/>
                <field name="tier_stage_locked" invisible="1"/>
                <field name="can_restart_validation_stage" invisible="1"/>
                <field name="stage_validation_status" invisible="1"/>
                <field name="has_stage_reviews" invisible="1"/>

                <button name="request_validation" type="object"
                        string="Solicitar aprobación"
                        class="btn-primary"
                        invisible="not need_validation or stage_validation_status == 'rejected' or hide_reviews"/>
                <button name="validate_tier" type="object"
                        string="Aprobar"
                        class="btn-success"
                        invisible="not can_review"/>
                <button name="reject_tier" type="object"
                        string="Rechazar"
                        class="btn-danger"
                        invisible="not can_review"/>
                <button name="restart_validation" type="object"
                        string="Reiniciar validación"
                        class="btn-secondary"
                        invisible="not can_restart_validation_stage or hide_reviews"
                        confirm="¿Reiniciar la validación de la fase actual?"/>
            </xpath>

            <!-- Banner de estado y página de revisiones dentro del sheet -->
            <xpath expr="//sheet" position="inside">
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="stage_validation_status == 'validated' or hide_reviews or stage_validation_status == 'rejected' or not has_stage_reviews">
                    <i class="fa fa-info-circle"/>
                    Esta solicitud necesita ser aprobada.
                </div>
                <div class="alert alert-success mb-0" role="alert"
                     invisible="stage_validation_status != 'validated' or hide_reviews or not has_stage_reviews">
                    <i class="fa fa-thumbs-up"/>
                    La fase fue aprobada.
                </div>
                <div class="alert alert-danger mb-0" role="alert"
                     invisible="stage_validation_status != 'rejected' or hide_reviews or not has_stage_reviews">
                    <i class="fa fa-thumbs-down"/>
                    La fase fue rechazada.
                </div>

                <group string="Aprobaciones" name="tier_reviews">
                    <field name="review_ids" nolabel="1">
                        <list create="0" delete="0">
                            <!--
                                Usamos string="Etapa" en lugar del label por
                                defecto del campo (que dice "Fase") para que
                                la columna sea consistente con el reporte.
                            -->
                            <field name="spend_phase" string="Etapa" optional="show"/>
                            <!--
                                Definition es el nivel/tier que originó la
                                review. Mostrarlo ayuda a entender qué regla de
                                aprobación se disparó (importe, área, etc.).
                            -->
                            <field name="definition_id" string="Validación" optional="show"/>
                            <field name="sequence" optional="show"/>
                            <field name="status"/>
                            <field name="todo_by"/>
                            <field name="done_by" optional="show"/>
                            <field name="reviewed_date" optional="show"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <!-- ===========================================
         Embedded form (dentro del expediente)
         =========================================== -->
    <record id="view_fund_expedient_form_sg_tier" model="ir.ui.view">
        <field name="name">fund.expedient.form.sg.embedded.tier</field>
        <field name="model">fund.expedient</field>
        <field name="inherit_id" ref="fund_expedient.view_fund_expedient_form"/>
        <field name="arch" type="xml">
            <!--
                El form embebido ya define <header> con el botón "Imprimir SG".
                Inyectamos los botones/statusbars del tier DENTRO de ese header
                (position="inside") para que queden en una sola fila junto al
                botón de impresión, en lugar de crear un segundo <header>.
            -->
            <xpath expr="//field[@name='spend_request_ids']/form/header" position="inside">
                <field name="preventiva_state" widget="statusbar"
                       statusbar_visible="draft,generated,approved"
                       invisible="spend_state == 'definitiva'"/>
                <field name="definitiva_state" widget="statusbar"
                       statusbar_visible="draft,generated,approved"
                       invisible="spend_state != 'definitiva'"/>

                <field name="spend_state" invisible="1"/>
                <field name="need_validation" invisible="1"/>
                <field name="validation_status" invisible="1"/>
                <field name="can_review" invisible="1"/>
                <field name="hide_reviews" invisible="1"/>
                <field name="has_comment" invisible="1"/>
                <field name="next_review" invisible="1"/>
                <field name="tier_stage_locked" invisible="1"/>
                <field name="can_restart_validation_stage" invisible="1"/>
                <field name="stage_validation_status" invisible="1"/>
                <field name="has_stage_reviews" invisible="1"/>

                <button name="request_validation" type="object"
                        string="Solicitar aprobación"
                        class="btn-primary"
                        invisible="not need_validation or stage_validation_status == 'rejected' or hide_reviews"/>
                <button name="validate_tier" type="object"
                        string="Aprobar"
                        class="btn-success"
                        invisible="not can_review"/>
                <button name="reject_tier" type="object"
                        string="Rechazar"
                        class="btn-danger"
                        invisible="not can_review"/>
                <button name="restart_validation" type="object"
                        string="Reiniciar validación"
                        class="btn-secondary"
                        invisible="not can_restart_validation_stage or hide_reviews"
                        confirm="¿Reiniciar la validación de la fase actual?"/>
            </xpath>

            <!-- Banners de estado: justo antes del grupo de identificación. -->
            <xpath expr="//field[@name='spend_request_ids']/form/group[@name='sg_identification']" position="before">
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="stage_validation_status == 'validated' or hide_reviews or stage_validation_status == 'rejected' or not has_stage_reviews">
                    <i class="fa fa-info-circle"/>
                    Esta solicitud necesita ser aprobada.
                </div>
                <div class="alert alert-success mb-0" role="alert"
                     invisible="stage_validation_status != 'validated' or hide_reviews or not has_stage_reviews">
                    <i class="fa fa-thumbs-up"/>
                    La fase fue aprobada.
                </div>
                <div class="alert alert-danger mb-0" role="alert"
                     invisible="stage_validation_status != 'rejected' or hide_reviews or not has_stage_reviews">
                    <i class="fa fa-thumbs-down"/>
                    La fase fue rechazada.
                </div>
            </xpath>

            <xpath expr="//field[@name='spend_request_ids']/form" position="inside">
                <group string="Aprobaciones" name="tier_reviews_embedded">
                    <field name="review_ids" nolabel="1">
                        <list create="0" delete="0">
                            <field name="spend_phase" string="Etapa"/>
                            <!-- Nombre de la regla de tier que disparó la review. -->
                            <field name="definition_id" string="Validación"/>
                            <field name="status"/>
                            <field name="todo_by"/>
                            <field name="done_by" optional="show"/>
                            <field name="reviewed_date" optional="show"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
