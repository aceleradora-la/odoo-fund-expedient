<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        La bandeja de aprobaciones es la app Mis aprobaciones
        (tier_validation_my_approvals). Acá solo se suma lo propio de la
        fundación: expediente, Solicitud de Gasto, etapa y fase.
    -->
    <record id="tier_review_view_list_my_approvals_fund" model="ir.ui.view">
        <field name="name">tier.review.list.my.approvals.fund</field>
        <field name="model">tier.review</field>
        <field name="inherit_id" ref="tier_validation_my_approvals.tier_review_view_list_my_approvals"/>
        <field name="arch" type="xml">
            <field name="res_name" position="after">
                <field name="fund_expedient_id" string="Expediente" optional="show"/>
                <field name="fund_spend_request_id" string="Solicitud de Gasto" optional="hide"/>
                <field name="stage_id" string="Etapa" optional="show"/>
                <field name="spend_phase" string="Fase SG" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="tier_review_view_form_my_approvals_fund" model="ir.ui.view">
        <field name="name">tier.review.form.my.approvals.fund</field>
        <field name="model">tier.review</field>
        <field name="inherit_id" ref="tier_validation_my_approvals.tier_review_view_form_my_approvals"/>
        <field name="arch" type="xml">
            <field name="res_model_id" position="after">
                <field name="fund_expedient_id" string="Expediente" invisible="not fund_expedient_id"/>
                <field name="fund_spend_request_id" string="Solicitud de Gasto"
                       invisible="not fund_spend_request_id"/>
                <field name="stage_id" string="Etapa" invisible="not stage_id"/>
                <field name="spend_phase" string="Fase SG" invisible="not spend_phase"/>
            </field>
        </field>
    </record>

    <record id="tier_review_view_search_my_approvals_fund" model="ir.ui.view">
        <field name="name">tier.review.search.my.approvals.fund</field>
        <field name="model">tier.review</field>
        <field name="inherit_id" ref="tier_validation_my_approvals.tier_review_view_search_my_approvals"/>
        <field name="arch" type="xml">
            <field name="res_model_id" position="after">
                <field name="fund_expedient_id" string="Expediente"/>
                <field name="stage_id" string="Etapa"/>
            </field>
            <filter name="group_res_model" position="after">
                <filter string="Expediente" name="group_expedient"
                        context="{'group_by': 'fund_expedient_id'}"/>
                <filter string="Etapa" name="group_stage"
                        context="{'group_by': 'stage_id'}"/>
            </filter>
        </field>
    </record>

    <!-- Acceso directo desde Expedientes. Conserva el id de la acción anterior
         para no perder los favoritos guardados sobre ella. -->
    <record id="action_tier_review_my_approvals" model="ir.actions.act_window">
        <field name="name">Mis aprobaciones</field>
        <field name="res_model">tier.review</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('model', 'in', ('fund.expedient', 'fund.expedient.spend.request'))]</field>
        <field name="context">{'search_default_can_review_mine': 1}</field>
        <field name="search_view_id" ref="tier_validation_my_approvals.tier_review_view_search_my_approvals"/>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('tier_validation_my_approvals.tier_review_view_list_my_approvals')}),
            Command.create({'view_mode': 'form', 'view_id': ref('tier_validation_my_approvals.tier_review_view_form_my_approvals')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No tenés aprobaciones pendientes de expedientes</p>
            <p>Todas tus aprobaciones (expedientes, solicitudes, facturas y más) están en la
               app <strong>Mis aprobaciones</strong>.</p>
        </field>
    </record>
</odoo>
