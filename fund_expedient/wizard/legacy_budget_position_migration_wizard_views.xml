<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_legacy_budget_position_migration_wizard_form" model="ir.ui.view">
        <field name="name">fund.legacy.budget.position.migration.wizard.form</field>
        <field name="model">fund.legacy.budget.position.migration.wizard</field>
        <field name="arch" type="xml">
            <form string="Migración: Partidas → Cuentas analíticas">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="apply_to_expedients"/>
                    <field name="apply_to_budget_lines"/>
                    <field name="apply_to_adjustment_lines"/>
                </group>
                <group string="Mapeos">
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="budget_position_id"/>
                            <field name="analytic_account_id"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_apply" string="Aplicar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_legacy_budget_position_migration_wizard" model="ir.actions.act_window">
        <field name="name">Migración legacy (Partidas → Analíticas)</field>
        <field name="res_model">fund.legacy.budget.position.migration.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>

