<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fund_expedient_notification_send_wizard" model="ir.ui.view">
        <field name="name">fund.expedient.notification.send.wizard.form</field>
        <field name="model">fund.expedient.notification.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Notificar oferentes">
                <group>
                    <field name="expedient_id" readonly="1"/>
                    <field name="stage_id" readonly="1"/>
                    <field name="mail_template_id" required="1"/>
                    <field name="mail_server_id"/>
                </group>
                <group>
                    <field name="info_message" nolabel="1" class="text-muted"/>
                </group>
                <group string="Documentos adjuntos del expediente">
                    <field name="document_ids" widget="many2many_tags" nolabel="1"
                           domain="[('expedient_id', '=', expedient_id)]"
                           options="{'no_create': True}"/>
                </group>
                <group>
                    <field name="pending_summary" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_send" string="Enviar pendientes" type="object" class="btn-primary"/>
                    <button special="cancel" string="Cerrar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
