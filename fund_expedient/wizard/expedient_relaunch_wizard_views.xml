<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fund_expedient_relaunch_wizard_form" model="ir.ui.view">
        <field name="name">fund.expedient.relaunch.wizard.form</field>
        <field name="model">fund.expedient.relaunch.wizard</field>
        <field name="arch" type="xml">
            <form string="Iniciar nuevo expediente">
                <field name="operation_type" invisible="1"/>
                <field name="current_type_id" invisible="1"/>
                <div class="alert alert-info" role="status">
                    Se crea un expediente nuevo con el solicitante, el objeto, la cuenta
                    analítica, las líneas (sin importes definitivos) y los documentos del
                    requerimiento. Arranca en la primera etapa del tipo elegido, con su propio
                    número, y queda vinculado a este. La Solicitud de Gasto no se copia: el
                    procedimiento nuevo certifica fondos de nuevo.
                </div>
                <div class="alert alert-warning" role="alert" invisible="not over_limit_warning">
                    <field name="over_limit_warning" nolabel="1"/>
                </div>
                <group>
                    <field name="expedient_id"/>
                    <field name="type_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Crear expediente"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
