<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fund_expedient_assign_wizard_form" model="ir.ui.view">
        <field name="name">fund.expedient.assign.wizard.form</field>
        <field name="model">fund.expedient.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Asignar responsable">
                <field name="allowed_user_ids" invisible="1"/>
                <group>
                    <field name="expedient_id" readonly="1"/>
                    <field name="user_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="note" placeholder="Opcional: por qué se reasigna"/>
                </group>
                <footer>
                    <button name="action_assign" type="object" string="Asignar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
