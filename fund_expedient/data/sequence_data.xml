<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="sequence_fund_expedient" model="ir.sequence">
            <field name="name">Secuencia Expedientes</field>
            <field name="code">fund.expedient</field>
            <field name="prefix">EXP-</field>
            <field name="padding">5</field>
            <field name="implementation">no_gap</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="sequence_fund_expedient_disposition" model="ir.sequence">
            <field name="name">Secuencia Disposiciones (Expedientes)</field>
            <field name="code">fund.expedient.disposition</field>
            <field name="prefix">DISP-</field>
            <field name="padding">5</field>
            <field name="implementation">no_gap</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="sequence_fund_expedient_resolution" model="ir.sequence">
            <field name="name">Secuencia Resoluciones (Expedientes)</field>
            <field name="code">fund.expedient.resolution</field>
            <field name="prefix">RES-</field>
            <field name="padding">5</field>
            <field name="implementation">no_gap</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="sequence_fund_expedient_spend_request" model="ir.sequence">
            <field name="name">Secuencia Solicitud de Gasto</field>
            <field name="code">fund.expedient.spend.request</field>
            <field name="prefix">SG-</field>
            <field name="padding">5</field>
            <field name="implementation">no_gap</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
