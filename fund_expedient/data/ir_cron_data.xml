<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Corre cada hora, pero quien decide si toca enviar es
            `_cron_send_pending_digest`, según la frecuencia y la hora que se
            configuran en Configuración de expedientes. De ese modo el usuario
            define el envío en lenguaje de negocio (diario/semanal/mensual) y no
            tocando el intervalo técnico de esta acción planificada.
        -->
        <record id="ir_cron_fund_expedient_pending_digest" model="ir.cron">
            <field name="name">Expedientes: resumen de pendientes</field>
            <field name="model_id" ref="fund_expedient.model_fund_expedient_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_pending_digest()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
