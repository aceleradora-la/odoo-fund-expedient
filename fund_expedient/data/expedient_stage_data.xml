<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="stage_expedient_draft" model="fund.expedient.stage">
            <field name="name">Borrador</field>
            <field name="sequence">1</field>
            <field name="state_type">draft</field>
        </record>
        <record id="stage_expedient_in_progress" model="fund.expedient.stage">
            <field name="name">En progreso</field>
            <field name="sequence">5</field>
            <field name="state_type">in_progress</field>
        </record>
        <record id="stage_expedient_purchases" model="fund.expedient.stage">
            <field name="name">Compras</field>
            <field name="sequence">7</field>
            <field name="state_type">purchases</field>
        </record>
        <record id="stage_expedient_to_approve" model="fund.expedient.stage">
            <field name="name">Por aprobar</field>
            <field name="sequence">10</field>
            <field name="state_type">to_approve</field>
        </record>
        <record id="stage_expedient_approved" model="fund.expedient.stage">
            <field name="name">Aprobado</field>
            <field name="sequence">15</field>
            <field name="state_type">approved</field>
            <field name="fold">True</field>
        </record>
        <record id="stage_expedient_cancel" model="fund.expedient.stage">
            <field name="name">Cancelado</field>
            <field name="sequence">20</field>
            <field name="state_type">cancel</field>
            <field name="fold">True</field>
        </record>
        <!--
            Etapas finales alternativas del flujo. El expediente llega a ellas
            únicamente aplicando una Disposición del tipo correspondiente;
            quedan fuera del avance secuencial (Siguiente etapa nunca entra).
            Para usarlas en un tipo de expediente hay que agregarlas a sus
            "Asignaciones por etapa" (igual que el resto de las etapas).
        -->
        <record id="stage_expedient_desierto" model="fund.expedient.stage">
            <field name="name">Declarar Desierto</field>
            <field name="sequence">16</field>
            <field name="state_type">no_award</field>
            <field name="final_outcome">desierto</field>
            <field name="fold">True</field>
        </record>
        <record id="stage_expedient_sin_efecto" model="fund.expedient.stage">
            <field name="name">Dejar sin efecto</field>
            <field name="sequence">17</field>
            <field name="state_type">no_award</field>
            <field name="final_outcome">sin_efecto</field>
            <field name="fold">True</field>
        </record>
        <record id="stage_expedient_fracasado" model="fund.expedient.stage">
            <field name="name">Declarar Fracasado</field>
            <field name="sequence">18</field>
            <field name="state_type">no_award</field>
            <field name="final_outcome">fracasado</field>
            <field name="fold">True</field>
        </record>
    </data>
    <!--
        Fuera de noupdate: se ejecuta en cada actualización del módulo para
        crear/reescribir las vistas de etapas generadas por código (agrega
        campos nuevos como `final_outcome` sin intervención manual).
    -->
    <data>
        <function model="fund.expedient.stage" name="init_expedient_stage_view"/>
    </data>
</odoo>
