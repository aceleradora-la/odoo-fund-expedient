<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Acción de reporte QWeb-PDF para la Solicitud de Gasto.
        Se enlaza al modelo (binding_model_id) para que aparezca en el
        menú "Imprimir / Reportes" del formulario y desde la lista.
    -->
    <record id="action_report_fund_expedient_spend_request" model="ir.actions.report">
        <field name="name">Solicitud de Gasto</field>
        <field name="model">fund.expedient.spend.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fund_expedient.report_fund_expedient_spend_request</field>
        <field name="report_file">fund_expedient.report_fund_expedient_spend_request</field>
        <field name="print_report_name">'SG-%s' % (object.number or object.id)</field>
        <field name="binding_model_id" ref="model_fund_expedient_spend_request"/>
        <field name="binding_type">report</field>
    </record>

    <!--
        Template QWeb del reporte. Diseñado para ser legible en una sola pasada:
        cabecera con datos clave (expediente, tipo, sector), bloque de
        importes preventivo/definitivo, listado de líneas y firmas.
    -->
    <template id="report_fund_expedient_spend_request_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=o.expedient_id.company_id.partner_id.lang or env.lang)"/>
            <!--
                Reducimos el tamaño base del reporte para que la tabla de
                detalle (10 columnas) entre en el ancho de página A4 sin
                desbordar. El layout externo (encabezado/footer) no se ve
                afectado porque su CSS está en otra escala.
            -->
            <div class="page sg-report" style="font-size: 10px;">
                <!--
                    Estilos locales del reporte de SG.

                    El layout externo de Odoo (o algún tema instalado) aplica
                    `border-radius` al `<thead>` y/o al `<table>` de las
                    tablas. Combinado con `border-collapse: collapse` (el
                    default de Bootstrap), se genera el efecto de "rectángulo
                    fantasma" debajo de la curva: la curva del thead queda
                    visualmente despegada del resto de la tabla y aparece una
                    línea recta extra debajo.

                    Solución: forzar tablas RECTANGULARES (border-radius: 0)
                    en este reporte y mantener `border-collapse: collapse`
                    para que Bootstrap dibuje sus líneas internas como
                    siempre. Así los totales y separaciones del tbody/tfoot
                    se respetan tal cual.
                -->
                <style>
                    /*
                        Forzamos border-radius: 0 a TODOS los elementos del
                        reporte. El tema/layout instalado aplica curvas en
                        múltiples selectores (table, thead, tr, td, pseudo
                        elementos) y un selector específico no cubre todos
                        los casos, dejando "fantasmas" curvos en esquinas.
                        Al usar `.sg-report *` con !important garantizamos
                        rectángulos limpios sin afectar otros reportes ni
                        al header/footer (que viven fuera de .sg-report).
                    */
                    .sg-report,
                    .sg-report *,
                    .sg-report *::before,
                    .sg-report *::after {
                        border-radius: 0 !important;
                        box-shadow: none !important;
                    }
                </style>
                <h2 class="mb-1" style="font-size: 20px;">
                    Solicitud de Gasto
                    <span t-if="o.number and o.number != '/'" t-esc="o.number"/>
                </h2>
                <!--
                    Subtítulo: dejamos solo la fase (Preventiva / Definitiva).
                    El número de expediente y de SG ya están en el cuerpo del
                    reporte; repetirlos en el display_name era ruido visual.
                -->
                <div class="text-muted mb-3">
                    <span t-field="o.spend_state"/>
                </div>

                <div class="row mt-2">
                    <div class="col-6">
                        <strong>Expediente:</strong>
                        <span t-field="o.expedient_id.number"/>
                        <br/>
                        <!--
                            Tipo y "Número por tipo" en líneas separadas:
                            mejora la legibilidad cuando el nombre del tipo
                            es largo y evita la sintaxis "Tipo (NUM)" que se
                            mezclaba con el resto del bloque.
                        -->
                        <strong>Tipo de expediente:</strong>
                        <span t-field="o.expedient_type_id"/>
                        <br/>
                        <t t-if="o.expedient_type_number">
                            <strong>Número por tipo:</strong>
                            <span t-field="o.expedient_type_number"/>
                            <br/>
                        </t>
                        <strong>Fase:</strong>
                        <span t-field="o.spend_state"/>
                        <br/>
                        <strong>Estado preventiva:</strong>
                        <span t-field="o.preventiva_state"/>
                        <t t-if="o.date_preventiva">
                            (<span t-field="o.date_preventiva"/>)
                        </t>
                        <br/>
                        <strong>Estado definitiva:</strong>
                        <span t-field="o.definitiva_state"/>
                        <t t-if="o.date_definitiva">
                            (<span t-field="o.date_definitiva"/>)
                        </t>
                    </div>
                    <div class="col-6">
                        <!--
                            Datos de la contratación SIEMPRE visibles (sin
                            t-if): aunque el expediente no los tenga cargados,
                            queremos que el reporte deje constancia explícita
                            del espacio (con valor vacío) y mantenga un layout
                            consistente con la vista en pantalla.
                            Objeto y lugar arriba del solicitante: primero el
                            "QUÉ" se contrata y luego "QUIÉN" lo pide.
                        -->
                        <strong>Objeto de la contratación:</strong>
                        <span t-field="o.contract_object"/>
                        <br/>
                        <strong>Lugar de Entrega/Ejecución:</strong>
                        <span t-field="o.delivery_location"/>
                        <br/>
                        <strong>Solicitante:</strong>
                        <span t-field="o.requestor_id"/>
                        <br/>
                        <strong>Sector requirente:</strong>
                        <span t-field="o.requestor_department_id"/>
                        <br/>
                        <strong>Responsable del sector:</strong>
                        <span t-field="o.requestor_department_manager_id"/>
                    </div>
                </div>

                <h4 class="mt-4" style="font-size: 13px;">Totales</h4>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Concepto</th>
                            <th class="text-end">Importe (moneda compañía)</th>
                            <th class="text-end">Importe (moneda tipo)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Preventivo</td>
                            <td class="text-end">
                                <span t-field="o.amount_preventiva"
                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                            <td class="text-end">
                                <span t-field="o.amount_preventiva_unit"
                                      t-options='{"widget": "monetary", "display_currency": o.approval_currency_id}'/>
                            </td>
                        </tr>
                        <tr>
                            <td>Definitivo</td>
                            <td class="text-end">
                                <span t-field="o.amount_definitiva"
                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                            <td class="text-end">
                                <span t-field="o.amount_definitiva_unit"
                                      t-options='{"widget": "monetary", "display_currency": o.approval_currency_id}'/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <h4 class="mt-3" style="font-size: 13px;">Bienes y/o servicios requeridos</h4>
                <!--
                    Tabla con muchas columnas: bajamos un punto la fuente y
                    apretamos el padding para evitar que se vaya de la página.
                -->
                <table class="table table-sm" style="font-size: 9px;">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Producto / Servicio</th>
                            <th>Descripción</th>
                            <th class="text-end">Cantidad</th>
                            <th>UoM</th>
                            <th>Cuenta analítica</th>
                            <th class="text-end">P. unitario est.</th>
                            <th class="text-end">Estimado</th>
                            <th class="text-end">P. unitario def.</th>
                            <th class="text-end">Definitivo</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.line_ids.sorted(key=lambda l: (l.sequence, l.id))" t-as="line">
                            <tr t-if="line.display_type == 'line_section'">
                                <td colspan="10">
                                    <strong t-field="line.name"/>
                                </td>
                            </tr>
                            <tr t-elif="line.display_type == 'line_note'">
                                <td colspan="10">
                                    <em t-field="line.name"/>
                                </td>
                            </tr>
                            <tr t-else="">
                                <td t-esc="line_index + 1"/>
                                <td><span t-field="line.product_id"/></td>
                                <td><span t-field="line.name"/></td>
                                <td class="text-end"><span t-field="line.product_qty"/></td>
                                <td><span t-field="line.product_uom_id"/></td>
                                <td><span t-field="line.analytic_account_id"/></td>
                                <td class="text-end">
                                    <span t-field="line.price_unit_estimated"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.amount_estimated_line"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.price_unit_final"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.amount_final_line"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!--
                    Totalizador por cuenta analítica.
                    Se agrupan las líneas de detalle por su `analytic_account_id`
                    y se suman los importes estimado y definitivo. Las líneas sin
                    cuenta asignada se agrupan bajo "Sin cuenta analítica".
                -->
                <t t-set="detail_lines" t-value="o.line_ids.filtered(lambda l: not l.display_type)"/>
                <t t-if="detail_lines">
                    <t t-set="analytic_accounts" t-value="detail_lines.mapped('analytic_account_id')"/>
                    <h4 class="mt-3" style="font-size: 13px;">Total por Cuenta Analítica</h4>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Cuenta analítica</th>
                                <th class="text-end">Total estimado</th>
                                <th class="text-end">Total definitivo</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="analytic_accounts.sorted(key=lambda a: (a.code or '', a.name or ''))" t-as="acc">
                                <t t-set="group_lines" t-value="detail_lines.filtered(lambda l: l.analytic_account_id == acc)"/>
                                <tr>
                                    <td><span t-esc="acc.code or ''"/></td>
                                    <td><span t-esc="acc.name or ''"/></td>
                                    <td class="text-end">
                                        <span t-esc="sum(group_lines.mapped('amount_estimated_line'))"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="sum(group_lines.mapped('amount_final_line'))"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                            <!-- Líneas sin cuenta analítica asignada -->
                            <t t-set="no_acc_lines" t-value="detail_lines.filtered(lambda l: not l.analytic_account_id)"/>
                            <tr t-if="no_acc_lines">
                                <td/>
                                <td><em>Sin cuenta analítica</em></td>
                                <td class="text-end">
                                    <span t-esc="sum(no_acc_lines.mapped('amount_estimated_line'))"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="sum(no_acc_lines.mapped('amount_final_line'))"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="2" class="text-end">Totales</th>
                                <th class="text-end">
                                    <span t-esc="sum(detail_lines.mapped('amount_estimated_line'))"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </th>
                                <th class="text-end">
                                    <span t-esc="sum(detail_lines.mapped('amount_final_line'))"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </th>
                            </tr>
                        </tfoot>
                    </table>
                </t>

                <!--
                    Grilla de proveedores sugeridos.
                    Se consolidan los proveedores recomendados de la cabecera
                    del expediente y los de cada línea, sin duplicados. Para
                    el "Contacto" tomamos el primer hijo del partner que sea
                    de tipo `contact`; si no hay, se omite y se muestran los
                    datos del propio partner.
                -->
                <t t-set="header_suppliers" t-value="o.expedient_id.recommended_supplier_ids"/>
                <t t-set="line_suppliers" t-value="o.expedient_id.line_ids.mapped('recommended_supplier_ids')"/>
                <t t-set="all_suppliers" t-value="(header_suppliers | line_suppliers).sorted(key=lambda p: (p.display_name or '').lower())"/>
                <t t-if="all_suppliers">
                    <h4 class="mt-3" style="font-size: 13px;">Proveedores sugeridos</h4>
                    <table class="table table-bordered table-sm">
                        <thead class="text-center">
                            <tr>
                                <th>Nombre / Razón social</th>
                                <th>Contacto</th>
                                <th>Email</th>
                                <th>Teléfono</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="all_suppliers" t-as="sup" class="text-center">
                                <t t-set="contact" t-value="sup.child_ids.filtered(lambda c: c.type == 'contact')[:1]"/>
                                <td><span t-esc="sup.display_name or ''"/></td>
                                <td><span t-esc="(contact.name if contact else '') or ''"/></td>
                                <td>
                                    <span t-esc="(contact.email if contact and contact.email else sup.email) or ''"/>
                                </td>
                                <td>
                                    <span t-esc="(contact.phone if contact and (contact.phone or contact.mobile) else (sup.phone or sup.mobile)) or ''"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </t>

                <!--
                    Grilla de aprobaciones (tier validation). Sólo se renderiza
                    si el módulo `expedient_tier_validation` está instalado y la
                    SG tiene revisiones. Mostramos exclusivamente las validadas/rechazadas
                    para que el reporte refleje historial real de aprobaciones.
                    Va siempre al final del documento: las aprobaciones cierran
                    el flujo y deben quedar como "firma" del reporte.
                -->
                <t t-if="'review_ids' in o._fields">
                    <t t-set="done_reviews" t-value="o.review_ids.filtered(lambda r: r.status in ('approved', 'rejected'))"/>
                    <t t-if="done_reviews">
                        <h4 class="mt-3" style="font-size: 13px;">Aprobaciones</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <!--
                                        Renombramos "Fase" → "Etapa": en este
                                        contexto la columna refiere a la etapa
                                        de la SG (preventiva/definitiva), que
                                        suena más natural para usuarios de
                                        negocio que el término "Fase".
                                    -->
                                    <th>Etapa</th>
                                    <th>Validación</th>
                                    <th>Nivel</th>
                                    <th>Estado</th>
                                    <th>Fecha de validación</th>
                                    <th>Aprobado por</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="done_reviews.sorted(key=lambda r: (r.spend_phase or '', r.sequence or 0, r.id))" t-as="rev">
                                    <td>
                                        <span t-if="rev.spend_phase == 'preventiva'">Preventiva</span>
                                        <span t-elif="rev.spend_phase == 'definitiva'">Definitiva</span>
                                        <span t-else=""/>
                                    </td>
                                    <!--
                                        Nombre del tier que originó la revisión.
                                        Permite identificar qué regla disparó la
                                        aprobación (p.ej. "Gerencia &gt; 100k").
                                    -->
                                    <td><span t-field="rev.definition_id"/></td>
                                    <td><span t-field="rev.sequence"/></td>
                                    <td>
                                        <span t-if="rev.status == 'approved'" class="text-success">Aprobada</span>
                                        <span t-elif="rev.status == 'rejected'" class="text-danger">Rechazada</span>
                                        <span t-else="" t-field="rev.status"/>
                                    </td>
                                    <td><span t-field="rev.reviewed_date"/></td>
                                    <td><span t-field="rev.done_by"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </t>
            </div>
        </t>
    </template>

    <!--
        Template "wrapper" requerido por Odoo: itera sobre los registros y
        llama al template del documento para cada uno.
    -->
    <template id="report_fund_expedient_spend_request">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="fund_expedient.report_fund_expedient_spend_request_document"/>
            </t>
        </t>
    </template>

</odoo>
