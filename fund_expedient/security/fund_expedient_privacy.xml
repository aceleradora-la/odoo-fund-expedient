<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Privacidad de los expedientes.

        Un expediente solo lo ven quienes participaron y los Administradores
        del módulo. Participante es quien:
          - lo creó;
          - figura en «Participantes» (`participant_user_ids`): solicitante,
            responsable del sector, asignados y responsables de cada etapa por
            la que pasó, aprobadores y quienes lo modificaron. Es acumulativo:
            quien estuvo en una etapa anterior lo sigue viendo. Todos ellos
            quedan además como seguidores, automáticamente;
          - es el responsable actual o está asignado a la etapa actual;
          - es seguidor (así se comparte con alguien más);
          - con Aprobaciones instalado, es aprobador del expediente o de sus
            documentos (reglas en expedient_tier_validation).

        Las reglas de grupo se suman (OR):
          - Administrador ve y opera todo;
          - Contrataciones lee todas las Locaciones (sus reportes, tablero y
            detalle), pero solo modifica aquello en lo que participa.

        Los modelos hijos (líneas, documentos, disposiciones, resoluciones,
        solicitudes de gasto, notificaciones) siguen al expediente: si no se
        ve el expediente, tampoco su detalle.

        Los ids de las reglas conservan el prefijo `rule_lease_privacy_` de
        la primera versión (solo Locaciones) para que la actualización las
        modifique en lugar de crear otras.

        No incluye el portal: los usuarios de portal tienen sus propias reglas
        (fund_expedient_portal), que ya se limitan a sus expedientes.
    -->
    <data>
        <record id="rule_lease_privacy_expedient_user" model="ir.rule">
            <field name="name">Expedientes: solo para participantes</field>
            <field name="model_id" ref="model_fund_expedient"/>
            <field name="groups" eval="[(4, ref('group_fund_expedient_user'))]"/>
            <field name="domain_force">['|', '|', '|', '|', ('create_uid', '=', user.id), ('participant_user_ids', 'in', [user.id]), ('responsible_user_id', '=', user.id), ('assignable_user_ids', 'in', [user.id]), ('message_partner_ids', 'in', [user.partner_id.id])]</field>
        </record>
        <record id="rule_lease_privacy_expedient_manager" model="ir.rule">
            <field name="name">Expedientes: Administrador ve todo</field>
            <field name="model_id" ref="model_fund_expedient"/>
            <field name="groups" eval="[(4, ref('group_fund_expedient_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_lease_privacy_expedient_contracting" model="ir.rule">
            <field name="name">Expedientes: Contrataciones lee las Locaciones</field>
            <field name="model_id" ref="model_fund_expedient"/>
            <field name="groups" eval="[(4, ref('group_fund_expedient_contracting'))]"/>
            <field name="domain_force">[('contract_kind', 'in', ['service_lease', 'work_lease'])]</field>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

