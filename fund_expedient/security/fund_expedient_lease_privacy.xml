<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Privacidad de las Locaciones de Servicios y de Obra.

        Son contratos con personas (honorarios, CUIT, datos personales): un
        expediente de Locación solo lo ven quienes participaron. El resto de
        los expedientes siguen visibles para todos los usuarios.

        Participante es quien:
          - lo creó;
          - figura en «Participantes» (`participant_user_ids`): solicitante,
            responsable del sector, asignados y responsables de cada etapa por
            la que pasó y quienes lo modificaron. Es acumulativo: quien estuvo
            en una etapa anterior lo sigue viendo;
          - es el responsable actual o está asignado a la etapa actual;
          - es seguidor (así se comparte con alguien más);
          - con Aprobaciones instalado, es aprobador del expediente o de sus
            documentos (reglas en expedient_tier_validation).

        Las reglas de grupo se suman (OR):
          - Administrador ve y opera todo;
          - Contrataciones lee todo (reportes, tablero y su detalle) pero solo
            modifica aquello en lo que participa.

        Los modelos hijos (líneas, documentos, disposiciones, resoluciones,
        solicitudes de gasto, notificaciones) siguen al expediente: si no se ve el
        expediente, tampoco su detalle. Las vistas de reporte de
        Contrataciones son modelos aparte y quedan reservadas a su grupo.

        No incluye el portal: los usuarios de portal tienen sus propias reglas
        (fund_expedient_portal), que ya se limitan a sus expedientes.
    -->
    <data>
        <record id="rule_lease_privacy_expedient_user" model="ir.rule">
            <field name="name">Expedientes: Locación solo para participantes</field>
            <field name="model_id" ref="model_fund_expedient"/>
            <field name="groups" eval="[(4, ref('group_fund_expedient_user'))]"/>
            <field name="domain_force">['|', ('contract_kind', 'not in', ['service_lease', 'work_lease']), '|', '|', '|', '|', ('create_uid', '=', user.id), ('participant_user_ids', 'in', [user.id]), ('responsible_user_id', '=', user.id), ('assignable_user_ids', 'in', [user.id]), ('message_partner_ids', 'in', [user.partner_id.id])]</field>
        </record>
        <record id="rule_lease_privacy_expedient_manager" model="ir.rule">
            <field name="name">Expedientes: Administrador ve todo</field>
