<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_expedient" model="ir.ui.view">
        <field name="name">account.payment.form.expedient</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="expedient_ids" widget="many2many_tags"
                       options="{'no_create': True}"
                       groups="fund_expedient.group_fund_expedient_user"/>
                <!-- Sin permisos de Expedientes: solo el número, en texto. -->
                <field name="expedient_names" readonly="1"
                       groups="!fund_expedient.group_fund_expedient_user"
                       invisible="not expedient_names"/>
            </xpath>
        </field>
    </record>
</odoo>
