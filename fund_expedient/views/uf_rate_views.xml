<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fund_uf_rate_list" model="ir.ui.view">
            <field name="name">fund.uf.rate.list</field>
        <field name="model">fund.uf.rate</field>
        <field name="arch" type="xml">
            <list string="Cotización UR" create="1" delete="1" edit="1">
                <field name="name"/>
                <field name="unit_type"/>
                <field name="rate"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_fund_uf_rate_form" model="ir.ui.view">
        <field name="name">fund.uf.rate.form</field>
        <field name="model">fund.uf.rate</field>
        <field name="arch" type="xml">
            <form string="Cotización UR">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="rate"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fund_uf_rate" model="ir.actions.act_window">
        <field name="name">Cotización UR</field>
        <field name="res_model">fund.uf.rate</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>
                Configure las cotizaciones de la Unidad Retributiva (UR) por fecha.
                Se utiliza la cotización vigente a la fecha del documento (OC o factura)
                para expresar los totales del expediente en UR.
            </p>
        </field>
    </record>
</odoo>
