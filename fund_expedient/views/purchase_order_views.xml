<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción para abrir solicitudes desde expediente sin permiso de crear (expediente no en etapa Compras) -->
    <record id="action_purchase_order_from_expedient_no_create" model="ir.actions.act_window">
        <field name="name">Solicitudes de cotización</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="create" eval="False"/>
    </record>

    <record id="view_purchase_order_form_expedient" model="ir.ui.view">
        <field name="name">purchase.order.form.expedient</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="expedient_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
