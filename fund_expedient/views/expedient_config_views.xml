<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_expedient_config_list" model="ir.ui.view">
        <field name="name">fund.expedient.config.list</field>
        <field name="model">fund.expedient.config</field>
        <field name="arch" type="xml">
            <list string="Configuración" create="1" delete="1" edit="1">
                <field name="company_id"/>
                <field name="expedient_service_product_id"/>
                <field name="analytic_plan_id"/>
            </list>
        </field>
    </record>

    <record id="view_expedient_config_form" model="ir.ui.view">
        <field name="name">fund.expedient.config.form</field>
        <field name="model">fund.expedient.config</field>
        <field name="arch" type="xml">
            <form string="Configuración de expedientes">
                <sheet>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="expedient_service_product_id"/>
                        <field name="analytic_plan_id"/>
                    </group>
                    <group string="Avisos por correo">
                        <field name="stage_assigned_template_id"
                               options="{'no_create': True}"/>
                        <div class="text-muted" colspan="2">
                            El aviso de etapa asignada se activa etapa por etapa, en
                            Tipos de expediente › Asignaciones por etapa ›
                            «Avisar por correo a los asignados».
                        </div>
                    </group>
                    <group string="Resumen de pendientes">
                        <field name="digest_active"/>
                        <field name="digest_frequency" invisible="not digest_active"
                               required="digest_active"/>
                        <field name="digest_weekday"
                               invisible="not digest_active or digest_frequency != 'weekly'"/>
                        <field name="digest_monthday"
                               invisible="not digest_active or digest_frequency != 'monthly'"/>
                        <field name="digest_hour" widget="float_time"
                               invisible="not digest_active"/>
                        <field name="digest_template_id" options="{'no_create': True}"
                               invisible="not digest_active" required="digest_active"/>
                        <field name="digest_last_sent" invisible="not digest_active"/>
                        <div class="text-muted" colspan="2" invisible="not digest_active">
                            Cada usuario recibe solo lo suyo, y únicamente si tiene
                            expedientes en su poder o aprobaciones pendientes.
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_expedient_config" model="ir.actions.act_window">
        <field name="name">Configuración de expedientes</field>
        <field name="res_model">fund.expedient.config</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p>
                Configure el producto de tipo servicio que se usará cuando una línea
                del expediente solo tiene descripción (sin producto asignado).
            </p>
        </field>
    </record>
</odoo>
