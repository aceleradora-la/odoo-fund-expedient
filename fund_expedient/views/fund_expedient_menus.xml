<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_fund_expedient_root"
              name="Expedientes"
              web_icon="fund_expedient,static/description/icon.svg"
              sequence="50"/>

    <menuitem id="menu_fund_expedient_config"
              name="Configuración"
              parent="menu_fund_expedient_root"
              sequence="100"/>

    <!-- Acciones (definir antes de los menuitems que las referencian) -->
    <record id="action_fund_expedient_stage" model="ir.actions.act_window">
        <field name="name">Etapas de expediente</field>
        <field name="res_model">fund.expedient.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_fund_expedient_encuadre" model="ir.actions.act_window">
        <field name="name">Encuadres</field>
        <field name="res_model">fund.expedient.encuadre</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_fund_expedient_document_type" model="ir.actions.act_window">
        <field name="name">Tipos de documento</field>
        <field name="res_model">fund.expedient.document.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree un tipo de documento
            </p>
            <p>
                Los tipos de documento se usan para clasificar los documentos del expediente
                y para exigirlos por etapa (en Tipos de expediente › Asignaciones por etapa ›
                Tipos de documento obligatorios).
            </p>
        </field>
    </record>

    <record id="action_fund_expedient_page" model="ir.actions.act_window">
        <field name="name">Solapas del expediente</field>
        <field name="res_model">fund.expedient.page</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>
                Catálogo de las solapas del formulario del expediente. Sirve para
                elegir, en cada etapa del tipo de expediente, cuáles se muestran
                («Solapas visibles» en las Asignaciones por etapa).
            </p>
        </field>
    </record>

    <record id="action_fund_expedient_type" model="ir.actions.act_window">
        <field name="name">Tipos de expediente</field>
        <field name="res_model">fund.expedient.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Configuración legacy (partidas/categorías) removida de la UI:
         el módulo migra a cuentas analíticas estándar de Odoo. -->

    <record id="action_fund_expedient_sequence" model="ir.actions.act_window">
        <field name="name">Secuencia de expedientes</field>
        <field name="res_model">ir.sequence</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="sequence_fund_expedient"/>
        <field name="target">current</field>
    </record>

    <record id="action_fund_expedient_disposition_report" model="ir.actions.act_window">
        <field name="name">Disposiciones</field>
        <field name="res_model">fund.expedient.disposition</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="view_id" ref="view_fund_expedient_disposition_list_report"/>
    </record>

    <record id="action_fund_expedient_resolution_report" model="ir.actions.act_window">
        <field name="name">Resoluciones</field>
        <field name="res_model">fund.expedient.resolution</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="view_id" ref="view_fund_expedient_resolution_list_report"/>
    </record>

    <record id="action_fund_expedient_spend_request" model="ir.actions.act_window">
        <field name="name">Solicitudes de Gasto</field>
        <field name="res_model">fund.expedient.spend.request</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="view_id" ref="view_fund_expedient_spend_request_list"/>
        <field name="search_view_id" ref="view_fund_expedient_spend_request_search"/>
    </record>

    <!-- Menuitems (después de las acciones) -->
    <menuitem id="menu_fund_expedient_list"
              name="Expedientes"
              parent="menu_fund_expedient_root"
              action="action_fund_expedient"
              sequence="10"/>

    <menuitem id="menu_fund_expedient_reports"
              name="Reportes"
              parent="menu_fund_expedient_root"
              sequence="15"/>
    <menuitem id="menu_fund_expedient_dashboard"
              name="Expedientes"
              parent="menu_fund_expedient_reports"
              action="action_fund_expedient_dashboard"
              sequence="10"/>

    <menuitem id="menu_fund_expedient_reports_resolutions"
              name="Resoluciones"
              parent="menu_fund_expedient_reports"
              action="action_fund_expedient_resolution_report"
              sequence="20"
              groups="fund_expedient.group_fund_expedient_manager"/>

    <menuitem id="menu_fund_expedient_reports_dispositions"
              name="Disposiciones"
              parent="menu_fund_expedient_reports"
              action="action_fund_expedient_disposition_report"
              sequence="25"
              groups="fund_expedient.group_fund_expedient_manager"/>

    <menuitem id="menu_fund_expedient_reports_spend_requests"
              name="Solicitudes de Gasto / Ingreso"
              parent="menu_fund_expedient_reports"
              action="action_fund_expedient_spend_request"
              sequence="30"
              groups="fund_expedient.group_fund_expedient_manager"/>

    <menuitem id="menu_fund_expedient_reports_locacion"
              name="Contrataciones (Locación)"
              parent="menu_fund_expedient_reports"
              action="action_expedient_locacion_contrataciones"
              sequence="40"
              groups="fund_expedient.group_fund_expedient_manager"/>

    <menuitem id="menu_fund_expedient_reports_locacion_projection"
              name="Proyección de Locación"
              parent="menu_fund_expedient_reports"
              action="action_expedient_locacion_projection"
              sequence="45"
              groups="fund_expedient.group_fund_expedient_manager"/>

    <menuitem id="menu_expedient_stage"
              name="Etapas de expediente"
              parent="menu_fund_expedient_config"
              action="action_fund_expedient_stage"
              sequence="10"
              groups="fund_expedient.group_fund_expedient_manager"/>

    <menuitem id="menu_expedient_encuadre"
              name="Encuadres"
              parent="menu_fund_expedient_config"
              action="action_fund_expedient_encuadre"
              sequence="20"
              groups="fund_expedient.group_fund_expedient_manager"/>

    <menuitem id="menu_expedient_document_type"
              name="Tipos de documento"
              parent="menu_fund_expedient_config"
              action="action_fund_expedient_document_type"
              sequence="22"
              groups="fund_expedient.group_fund_expedient_manager"/>

    <menuitem id="menu_expedient_page"
              name="Solapas del expediente"
              parent="menu_fund_expedient_config"
              action="action_fund_expedient_page"
              sequence="23"
              groups="fund_expedient.group_fund_expedient_manager"/>

    <menuitem id="menu_expedient_type"
              name="Tipos de expediente"
              parent="menu_fund_expedient_config"
              action="action_fund_expedient_type"
              sequence="25"
              groups="fund_expedient.group_fund_expedient_manager"/>

    <menuitem id="menu_expedient_sequence"
              name="Numeración de expedientes"
              parent="menu_fund_expedient_config"
              action="action_fund_expedient_sequence"
              sequence="5"
              groups="fund_expedient.group_fund_expedient_manager"/>

    <menuitem id="menu_expedient_config"
              name="Configuración de expedientes"
              parent="menu_fund_expedient_config"
              action="action_expedient_config"
              sequence="42"
              groups="fund_expedient.group_fund_expedient_manager"/>

    <!-- Presupuesto -->
    <menuitem id="menu_fund_budget_root"
              name="Presupuesto"
              parent="menu_fund_expedient_root"
              sequence="20"/>
    <menuitem id="menu_fund_budget_list"
              name="Presupuestos"
              parent="menu_fund_budget_root"
              action="action_fund_budget"
              sequence="10"/>
    <menuitem id="menu_fund_budget_adjustment"
              name="Ajustes"
              parent="menu_fund_budget_root"
              action="action_fund_budget_adjustment"
              sequence="20"/>
</odoo>
