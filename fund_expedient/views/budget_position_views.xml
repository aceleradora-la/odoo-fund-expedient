<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
    <record id="view_budget_position_category_list" model="ir.ui.view">
        <field name="name">fund.budget.position.category.list</field>
        <field name="model">fund.budget.position.category</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Categorías de partida" create="1" delete="1" edit="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_budget_position_category_form" model="ir.ui.view">
        <field name="name">fund.budget.position.category.form</field>
        <field name="model">fund.budget.position.category</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Categoría de partida">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_budget_position_list" model="ir.ui.view">
        <field name="name">fund.budget.position.list</field>
        <field name="model">fund.budget.position</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Partidas presupuestarias" create="1" delete="1">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="type"/>
                <field name="budget_assignment_allowed"/>
                <field name="category_id"/>
                <field name="parent_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_budget_position_form" model="ir.ui.view">
        <field name="name">fund.budget.position.form</field>
        <field name="model">fund.budget.position</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Partida presupuestaria">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="type"/>
                            <field name="budget_assignment_allowed"/>
                            <field name="category_id"/>
                            <field name="parent_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    </data>
</odoo>
