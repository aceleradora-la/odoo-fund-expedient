<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fund_expedient_list" model="ir.ui.view">
        <field name="name">fund.expedient.list</field>
        <field name="model">fund.expedient</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Expedientes" multi_edit="1" create="1">
                <field name="number"/>
                <field name="type_number" optional="show"/>
                <field name="request_date"/>
                <field name="requestor_id"/>
                <field name="recommended_supplier_ids" widget="many2many_tags"
                       options="{'no_create': True, 'search_view_ref': 'fund_expedient.view_res_partner_recommended_supplier_search'}"
                       context="{'search_view_ref': 'fund_expedient.view_res_partner_recommended_supplier_search'}"/>
                <field name="budget_position_id"/>
                <field name="encuadre_id"/>
                <field name="type_id"/>
                <field name="stage_id"/>
                <field name="state" column_invisible="1"/>
                <field name="project_ids" widget="many2many_tags"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_fund_expedient_kanban" model="ir.ui.view">
        <field name="name">fund.expedient.kanban</field>
        <field name="model">fund.expedient</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id"
                    class="o_kanban_small_column"
                    create="1"
                    group_create="false"
                    group_edit="false"
                    group_delete="false">
                <field name="number"/>
                <field name="request_date"/>
                <field name="requestor_id"/>
                <field name="recommended_supplier_ids" widget="many2many_tags"
                       options="{'no_create': True, 'search_view_ref': 'fund_expedient.view_res_partner_recommended_supplier_search'}"
                       context="{'search_view_ref': 'fund_expedient.view_res_partner_recommended_supplier_search'}"/>
                <field name="stage_id" options="{'no_create': True}"/>
                <field name="state"/>
                <field name="description_plain"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column">
                            <strong><field name="number"/></strong>
                            <field name="description_plain" widget="text" class="text-muted mt-1" style="font-size: 0.9em; max-height: 3em; overflow: hidden;"/>
                            <div class="mt-2">
                                <field name="request_date" widget="date"/>
                                <field name="requestor_id"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_fund_expedient_form" model="ir.ui.view">
        <field name="name">fund.expedient.form</field>
        <field name="model">fund.expedient</field>
        <field name="arch" type="xml">
            <form string="Expediente">
                <header>
                    <field name="stage_id" widget="statusbar"/>
                    <field name="state" invisible="1"/>
                    <field name="can_edit_in_stage" invisible="1"/>
                    <field name="allowed_stage_ids" invisible="1"/>
                    <field name="stage_spend_request_mode" invisible="1"/>
                    <field name="has_dispositions_feature" invisible="1"/>
                    <field name="has_resolutions_feature" invisible="1"/>
                    <field name="current_assign_require_disposition" invisible="1"/>
                    <field name="current_assign_require_resolution" invisible="1"/>
                    <field name="current_assign_require_notification" invisible="1"/>
                    <field name="current_stage_notification_template_id" invisible="1"/>
                    <field name="line_amounts_drive_estimated" invisible="1"/>
                    <field name="line_amounts_drive_confirmed" invisible="1"/>
                    <field name="requestor_user_id" invisible="1"/>
                    <field name="hide_type_id_stage" invisible="1"/>
                    <field name="type_id_editable_in_stage" invisible="1"/>
                    <field name="line_amount_final_editable" invisible="1"/>
                    <field name="hide_encuadre_id_stage" invisible="1"/>
                    <field name="hide_estimated_need_date_stage" invisible="1"/>
                    <field name="hide_recommended_supplier_id_stage" invisible="1"/>
                    <field name="hide_recommended_supplier_ids_stage" invisible="1"/>
                    <field name="hide_budget_position_id_stage" invisible="1"/>
                    <field name="hide_amount_estimated_stage" invisible="1"/>
                    <button name="action_previous_stage" type="object" string="Etapa anterior"
                            class="btn-secondary"
                            modifiers='{"invisible": ["|", ["state", "=", "cancel"], ["can_edit_in_stage", "=", false]]}'/>
                    <button name="action_next_stage" type="object" string="Siguiente etapa"
                            class="btn-primary"
                            modifiers='{"invisible": ["|", ["state", "=", "cancel"], ["can_edit_in_stage", "=", false]]}'/>
                    <button name="action_open_notification_wizard" type="object"
                            string="Notificar oferentes"
                            class="btn-secondary"
                            invisible="state == 'cancel' or not can_edit_in_stage or (not current_assign_require_notification and not current_stage_notification_template_id)"/>
                    <button name="action_create_spend_request_initial" type="object"
                            string="Crear SG preventiva"
                            class="btn-secondary"
                            invisible="state == 'cancel' or not can_edit_in_stage or stage_spend_request_mode != 'preventiva'"/>
                    <button name="action_create_spend_request_final" type="object"
                            string="Crear SG Definitiva"
                            class="btn-secondary"
                            invisible="state == 'cancel' or not can_edit_in_stage or stage_spend_request_mode != 'final'"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            class="btn-danger" invisible="state == 'cancel' or not can_edit_in_stage"
                            confirm="¿Está seguro de que desea cancelar este expediente?"/>
                </header>
                <sheet readonly="not can_edit_in_stage">
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="purchase_order_count"/></span>
                                <span class="o_stat_text">Solicitudes</span>
                            </div>
                        </button>
                        <button name="action_view_projects" type="object"
                                class="oe_stat_button" icon="fa-folder-open">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="project_count"/></span>
                                <span class="o_stat_text">Proyectos</span>
                            </div>
                        </button>
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="invoice_count"/></span>
                                <span class="o_stat_text">Facturas</span>
                            </div>
                        </button>
                        <button name="action_view_payments" type="object"
                                class="oe_stat_button" icon="fa-credit-card">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="payment_count"/></span>
                                <span class="o_stat_text">Pagos</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Cancelado" bg_color="text-bg-danger" invisible="state != 'cancel'"/>
                    <group>
                        <group string="Identificación">
                            <field name="number" readonly="1"/>
                            <field name="type_number" readonly="1" invisible="not type_number"/>
                            <field name="request_date"/>
                            <field name="type_id" invisible="hide_type_id_stage" readonly="not type_id_editable_in_stage"/>
                            <field name="type_unit_mode" invisible="1"/>
                            <field name="show_encuadre" invisible="1"/>
                            <field name="encuadre_id" invisible="not show_encuadre or hide_encuadre_id_stage"/>
                            <field name="estimated_need_date" invisible="hide_estimated_need_date_stage"/>
                            <field name="requestor_id"/>
                            <field name="recommended_supplier_ids" widget="many2many_tags" invisible="hide_recommended_supplier_ids_stage"
                                   options="{'no_create': True, 'search_view_ref': 'fund_expedient.view_res_partner_recommended_supplier_search'}"
                                   context="{'search_view_ref': 'fund_expedient.view_res_partner_recommended_supplier_search'}"/>
                        </group>
                        <group string="Clasificación">
                            <field name="analytic_plan_id" invisible="1"/>
                            <field name="analytic_account_id" invisible="hide_analytic_account_id_stage"/>
                            <field name="budget_position_id" invisible="1"/>
                            <field name="project_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Totales" name="totals">
                        <group string="Moneda (compañía)">
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_estimated_manual"
                                   invisible="hide_amount_estimated_stage or line_amounts_drive_estimated"/>
                            <field name="amount_estimated"
                                   invisible="hide_amount_estimated_stage"
                                   readonly="line_amounts_drive_estimated"/>
                            <field name="amount_committed" readonly="1"/>
                            <field name="amount_real" readonly="1"/>
                        </group>
                        <group string="Moneda (tipo de expediente)" invisible="not approval_currency_id">
                            <field name="approval_currency_id" readonly="1"/>
                            <field name="amount_estimated_unit" readonly="1" invisible="hide_amount_estimated_stage"/>
                            <field name="amount_committed_unit" readonly="1"/>
                            <field name="amount_real_unit" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción/Memo" name="description">
                            <field name="description"
                                   widget="html"
                                   placeholder="Descripción o memo de la solicitud..."
                                   nolabel="1"
                                   readonly="state != 'draft'"/>
                        </page>
                        <page string="Líneas" name="lines">
                            <field name="can_create_purchase" invisible="1"/>
                            <button name="action_wizard_create_purchase" type="object"
                                    string="Crear solicitud desde líneas"
                                    class="btn-primary mb-2"
                                    invisible="not can_create_purchase or not line_ids"/>
                            <field name="line_ids" nolabel="1">
                                <list create="1" delete="1" edit="1">
                                    <field name="sequence" widget="handle"/>
                                    <field name="display_type" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="amount_estimated_line"/>
                                    <field name="budget_position_id" optional="show"/>
                                    <field name="analytic_account_id" optional="show"/>
                                    <field name="amount_final_line" readonly="not parent.line_amount_final_editable"/>
                                    <field name="recommended_supplier_ids" widget="many2many_tags"
                       options="{'no_create': True, 'search_view_ref': 'fund_expedient.view_res_partner_recommended_supplier_search'}"
                       context="{'search_view_ref': 'fund_expedient.view_res_partner_recommended_supplier_search'}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Solicitud de Gasto" name="spend_request">
                            <field name="spend_request_ids" nolabel="1" create="0" delete="0"
                                   context="{'default_expedient_id': id}">
                                <list create="0" delete="0" edit="0">
                                    <field name="number"/>
                                    <field name="spend_state"/>
                                    <field name="date_preventiva"/>
                                    <field name="date_definitiva"/>
                                </list>
                                <form string="Solicitud de Gasto">
                                    <group string="Solicitud de gasto" name="sg_identification">
                                        <group>
                                    <field name="number" readonly="1"/>
                                    <field name="spend_state" readonly="1"/>
                                    <field name="preventiva_state" readonly="1"/>
                                    <field name="definitiva_state" readonly="1"/>
                                    <field name="final_number" readonly="1" optional="hide"/>
                                        </group>
                                        <group>
                                            <field name="currency_id" invisible="1"/>
                                            <field name="approval_currency_id" invisible="1"/>
                                        </group>
                                    </group>
                                    <group string="Preventiva">
                                        <group>
                                            <field name="date_preventiva" readonly="1"/>
                                        </group>
                                        <group>
                                            <field name="amount_preventiva" readonly="1"/>
                                            <field name="amount_preventiva_unit" readonly="1"/>
                                        </group>
                                    </group>
                                    <group string="Definitiva">
                                        <group>
                                            <field name="date_definitiva" readonly="1"/>
                                        </group>
                                        <group>
                                            <field name="amount_definitiva" readonly="1"/>
                                            <field name="amount_definitiva_unit" readonly="1"/>
                                        </group>
                                    </group>
                                    <group string="Líneas">
                                        <field name="line_ids" nolabel="1" readonly="1">
                                            <list create="0" delete="0" edit="0">
                                                <field name="sequence" widget="handle"/>
                                                <field name="display_type" column_invisible="1"/>
                                                <field name="product_id"/>
                                                <field name="name"/>
                                                <field name="product_qty"/>
                                                <field name="product_uom_id"/>
                                                <field name="budget_position_id" optional="show"/>
                                                <field name="analytic_account_id" optional="show"/>
                                                <field name="amount_estimated_line"/>
                                                <field name="amount_final_line"/>
                                            </list>
                                        </field>
                                    </group>
                                </form>
                            </field>
                            <group string="Total Estimado Confirmado (expediente)">
                                <group string="Moneda (compañía)">
                                    <field name="amount_estimated_confirmed_manual"
                                           invisible="line_amounts_drive_confirmed"
                                           readonly="not line_amount_final_editable"/>
                                    <field name="amount_estimated_confirmed" readonly="1"/>
                                </group>
                                <group string="Moneda (tipo de expediente)" invisible="not approval_currency_id">
                                    <field name="amount_estimated_confirmed_unit" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Disposiciones" name="dispositions" invisible="not has_dispositions_feature">
                            <field name="disposition_ids" nolabel="1"
                                   readonly="not current_assign_require_disposition"
                                   context="{'default_expedient_id': id, 'default_stage_id': stage_id}">
                                <list create="1" delete="1" edit="1">
                                    <field name="sequence" widget="handle"/>
                                    <field name="stage_id" options="{'no_create': True}"/>
                                    <field name="number" readonly="1"/>
                                    <field name="disposition_date"/>
                                </list>
                                <form string="Disposición">
                                    <group>
                                        <group>
                                            <field name="expedient_id" readonly="1"/>
                                            <field name="stage_id" options="{'no_create': True}"/>
                                            <field name="sequence"/>
                                            <field name="number" readonly="1"/>
                                            <field name="disposition_date"/>
                                        </group>
                                    </group>
                                    <group>
                                        <field name="notes" widget="html" placeholder="Observaciones..." nolabel="1"/>
                                    </group>
                                    <group string="Documentos relacionados">
                                        <field name="document_ids" nolabel="1"
                                               context="{'default_expedient_id': expedient_id, 'default_stage_id': stage_id, 'default_disposition_id': id}">
                                            <list create="1" delete="1" edit="1">
                                                <field name="number"/>
                                                <field name="file_name"/>
                                                <field name="name"/>
                                                <field name="delivered"/>
                                                <button type="object"
                                                        name="action_open_document"
                                                        string="Abrir"
                                                        class="btn-secondary"/>
                                            </list>
                                        </field>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Resoluciones" name="resolutions" invisible="not has_resolutions_feature">
                            <field name="resolution_ids" nolabel="1"
                                   readonly="not current_assign_require_resolution"
                                   context="{'default_expedient_id': id, 'default_stage_id': stage_id}">
                                <list create="1" delete="1" edit="1">
                                    <field name="sequence" widget="handle"/>
                                    <field name="stage_id" options="{'no_create': True}"/>
                                    <field name="number" readonly="1"/>
                                    <field name="resolution_date"/>
                                </list>
                                <form string="Resolución">
                                    <group>
                                        <group>
                                            <field name="expedient_id" readonly="1"/>
                                            <field name="stage_id" options="{'no_create': True}"/>
                                            <field name="sequence"/>
                                            <field name="number" readonly="1"/>
                                            <field name="resolution_date"/>
                                        </group>
                                    </group>
                                    <group>
                                        <field name="notes" widget="html" placeholder="Observaciones..." nolabel="1"/>
                                    </group>
                                    <group string="Documentos relacionados">
                                        <field name="document_ids" nolabel="1"
                                               context="{'default_expedient_id': expedient_id, 'default_stage_id': stage_id, 'default_resolution_id': id}">
                                            <list create="1" delete="1" edit="1">
                                                <field name="number"/>
                                                <field name="file_name"/>
                                                <field name="name"/>
                                                <field name="delivered"/>
                                                <button type="object"
                                                        name="action_open_document"
                                                        string="Abrir"
                                                        class="btn-secondary"/>
                                            </list>
                                        </field>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Notificaciones (correo)" name="notification_mails">
                            <field name="notification_mail_ids" nolabel="1" create="0" delete="0" edit="0">
                                <list>
                                    <field name="create_date" string="Fecha"/>
                                    <field name="stage_id"/>
                                    <field name="partner_id"/>
                                    <field name="subject"/>
                                    <field name="state"/>
                                    <field name="template_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Documentos por etapa" name="stage_documents">
                            <field name="document_ids" nolabel="1" context="{'default_stage_id': stage_id}">
                                <list create="1" delete="1" edit="1">
                                    <field name="sequence" widget="handle"/>
                                    <field name="number" readonly="1"/>
                                    <field name="file_name" string="Archivo"/>
                                    <field name="delivered"/>
                                    <field name="notes"/>
                                    <field name="stage_id" optional="hide" readonly="1"/>
                                    <field name="disposition_id" optional="hide"/>
                                    <field name="resolution_id" optional="hide"/>
                                    <field name="can_download_file" column_invisible="1"/>
                                    <field name="can_unlink_file" column_invisible="1"/>
                                    <button type="object"
                                            name="action_preview_file"
                                            string="Previsualizar"
                                            class="btn-secondary"/>
                                    <button type="object"
                                            name="action_download_file"
                                            string="Descargar"
                                            class="btn-primary"
                                            invisible="not can_download_file"/>
                                </list>
                                <form string="Documento por etapa">
                                    <group>
                                        <group>
                                            <field name="expedient_id" readonly="1"/>
                                            <field name="number" readonly="1"/>
                                            <field name="stage_id" readonly="1" options="{'no_create': True}"/>
                                            <field name="disposition_id"/>
                                            <field name="resolution_id"/>
                                            <field name="delivered"/>
                                        </group>
                                        <group>
                                            <field name="can_download_file" invisible="1"/>
                                            <field name="can_unlink_file" invisible="1"/>
                                            <!-- Subida: solo en etapa actual y asignado -->
                                            <field name="file_data" filename="file_name" widget="binary"
                                                   invisible="not can_download_file or file_data"
                                                   readonly="not can_download_file"/>
                                            <!-- Visualización: evitar widget binary (descarga directa) -->
                                            <field name="file_name" readonly="1" invisible="not file_data"/>
                                            <button type="object"
                                                    name="action_preview_file"
                                                    string="Previsualizar"
                                                    class="btn-secondary"
                                                    invisible="not file_data"/>
                                            <button type="object"
                                                    name="action_download_file"
                                                    string="Descargar"
                                                    class="btn-primary"
                                                    invisible="not file_data or not can_download_file"/>
                                            <field name="name" invisible="1"/>
                                        </group>
                                    </group>
                                    <group>
                                        <field name="notes"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Expedientes relacionados" name="children">
                            <field name="parent_id"/>
                            <field name="child_ids" nolabel="1" readonly="1">
                                <list create="1" delete="1" edit="1">
                                    <field name="number"/>
                                    <field name="request_date"/>
                                    <field name="stage_id"/>
                                    <field name="requestor_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Solicitudes de cotización" name="purchases">
                            <field name="can_create_purchase" invisible="1"/>
                            <field name="purchase_order_ids" nolabel="1">
                                <list create="can_create_purchase" delete="0" open="0">
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="date_order"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Facturas" name="invoices">
                            <field name="direct_invoice_ids" nolabel="1"
                                   context="{'default_move_type': 'in_invoice'}">
                                <list create="1" delete="1" open="1">
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="invoice_date"/>
                                    <field name="amount_total"/>
                                    <field name="state"/>
                                    <field name="move_type" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Pagos" name="payments">
                            <field name="payment_ids" nolabel="1">
                                <list create="0" delete="0" open="1">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="partner_id"/>
                                    <field name="amount"/>
                                    <field name="currency_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fund_expedient_search" model="ir.ui.view">
        <field name="name">fund.expedient.search</field>
        <field name="model">fund.expedient</field>
        <field name="arch" type="xml">
            <search string="Buscar expedientes">
                <field name="number"/>
                <field name="description_plain" string="Descripción/Memo"/>
                <field name="requestor_id"/>
                <field name="recommended_supplier_ids"/>
                <field name="budget_position_id"/>
                <field name="encuadre_id"/>
                <field name="type_id"/>
                <field name="project_ids"/>
                <filter string="Míos o asignados" name="my_or_assigned"
                        domain="['|', ('requestor_id.user_id', '=', uid), ('assignable_user_ids', 'in', uid)]"/>
                <filter string="Creados por mí" name="my_created" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter string="Por aprobar" name="to_approve" domain="[('state', '=', 'to_approve')]"/>
                <filter string="Aprobados" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Cancelados" name="cancelled" domain="[('state', '=', 'cancel')]"/>
                <filter string="Activos (no cancelados)" name="not_cancelled" domain="[('state', '!=', 'cancel')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Etapa" name="group_stage" context="{'group_by': 'stage_id'}"/>
                    <filter string="Solicitante" name="group_requestor" context="{'group_by': 'requestor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fund_expedient" model="ir.actions.act_window">
        <field name="name">Expedientes</field>
        <field name="res_model">fund.expedient</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_fund_expedient_search"/>
        <field name="context">{'search_default_my_or_assigned': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un expediente
            </p>
            <p>
                Los expedientes permiten gestionar solicitudes con etapas, partida presupuestaria,
                relación con solicitudes de cotización y proyectos.
            </p>
        </field>
    </record>

    <!-- Reportes / Tablero de expedientes -->
    <record id="view_fund_expedient_pivot" model="ir.ui.view">
        <field name="name">fund.expedient.pivot</field>
        <field name="model">fund.expedient</field>
        <field name="type">pivot</field>
        <field name="arch" type="xml">
            <pivot string="Expedientes - Análisis">
                <field name="stage_id" type="row"/>
                <field name="type_id" type="row"/>
                <field name="budget_position_id" type="row"/>
                <field name="request_date" interval="month" type="col"/>
                <field name="report_count" type="measure"/>
                <field name="amount_estimated" type="measure"/>
                <field name="amount_committed" type="measure"/>
                <field name="amount_real" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_fund_expedient_graph" model="ir.ui.view">
        <field name="name">fund.expedient.graph</field>
        <field name="model">fund.expedient</field>
        <field name="type">graph</field>
        <field name="arch" type="xml">
            <graph string="Montos por etapa (Real vs Estimado)" type="bar">
                <field name="stage_id"/>
                <field name="amount_estimated" type="measure"/>
                <field name="amount_committed" type="measure"/>
                <field name="amount_real" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_fund_expedient_graph_count" model="ir.ui.view">
        <field name="name">fund.expedient.graph.count</field>
        <field name="model">fund.expedient</field>
        <field name="type">graph</field>
        <field name="arch" type="xml">
            <graph string="Cantidad de expedientes por etapa" type="bar">
                <field name="stage_id"/>
                <field name="report_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_fund_expedient_dashboard" model="ir.actions.act_window">
        <field name="name">Reportes - Expedientes</field>
        <field name="res_model">fund.expedient</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_fund_expedient_search"/>
        <field name="context">{'search_default_not_cancelled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Reportes - Expedientes
            </p>
            <p>
                Use la vista <b>Pivote</b> para cantidad de expedientes, por etapa, tipo o partida, y sumatorias de estimado, comprometido y real.
                Use la vista <b>Gráfico</b> para expedientes por etapa o montos. Real vs presupuesto: compare Total Real con Total Estimado en el pivote.
            </p>
            <p>
                Para llevarlo al <b>Tableros</b> de Odoo (como Ventas, Finanzas): en Pivote o Gráfico, use <b>Insertar en hoja de cálculo</b> y elija el tablero o sección donde añadirlo.
            </p>
        </field>
    </record>
</odoo>
