<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fund_expedient_list" model="ir.ui.view">
        <field name="name">fund.expedient.list</field>
        <field name="model">fund.expedient</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Expedientes" multi_edit="1" create="1">
                <field name="number"/>
                <field name="request_date"/>
                <field name="requestor_id"/>
                <field name="recommended_supplier_id"/>
                <field name="budget_position_id"/>
                <field name="encuadre_id"/>
                <field name="type_id"/>
                <field name="stage_id"/>
                <field name="state" column_invisible="1"/>
                <field name="project_ids" widget="many2many_tags"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_fund_expedient_kanban" model="ir.ui.view">
        <field name="name">fund.expedient.kanban</field>
        <field name="model">fund.expedient</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" create="1">
                <field name="number"/>
                <field name="request_date"/>
                <field name="requestor_id"/>
                <field name="recommended_supplier_id"/>
                <field name="stage_id"/>
                <field name="state"/>
                <field name="description"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column">
                            <strong><field name="number"/></strong>
                            <field name="description" widget="text" class="text-muted mt-1" style="font-size: 0.9em; max-height: 3em; overflow: hidden;"/>
                            <div class="mt-2">
                                <field name="request_date" widget="date"/>
                                <field name="requestor_id"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_fund_expedient_form" model="ir.ui.view">
        <field name="name">fund.expedient.form</field>
        <field name="model">fund.expedient</field>
        <field name="arch" type="xml">
            <form string="Expediente">
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                    <field name="state" invisible="1"/>
                    <button name="action_previous_stage" type="object" string="Etapa anterior"
                            class="btn-secondary"
                            modifiers="{'invisible': [['state', '=', 'cancel']]}"/>
                    <button name="action_next_stage" type="object" string="Siguiente etapa"
                            class="btn-primary"
                            modifiers="{'invisible': [['state', '=', 'cancel']]}"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            class="btn-danger" invisible="state == 'cancel'"
                            confirm="¿Está seguro de que desea cancelar este expediente?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="purchase_order_count"/></span>
                                <span class="o_stat_text">Solicitudes</span>
                            </div>
                        </button>
                        <button name="action_view_projects" type="object"
                                class="oe_stat_button" icon="fa-folder-open">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="project_count"/></span>
                                <span class="o_stat_text">Proyectos</span>
                            </div>
                        </button>
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="invoice_count"/></span>
                                <span class="o_stat_text">Facturas</span>
                            </div>
                        </button>
                        <button name="action_view_payments" type="object"
                                class="oe_stat_button" icon="fa-credit-card">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="payment_count"/></span>
                                <span class="o_stat_text">Pagos</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Cancelado" bg_color="text-bg-danger" invisible="state != 'cancel'"/>
                    <group>
                        <group string="Identificación">
                            <field name="number" readonly="1"/>
                            <field name="request_date"/>
                            <field name="type_id"/>
                            <field name="encuadre_id"
                                   modifiers="{'invisible': [['stage_id.state_type', '!=', 'purchases']]}"/>
                            <field name="estimated_need_date"/>
                            <field name="requestor_id"/>
                            <field name="recommended_supplier_id"/>
                        </group>
                        <group string="Clasificación">
                            <field name="budget_position_id"/>
                            <field name="project_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Totales" name="totals">
                        <group string="Moneda (compañía)">
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_estimated"/>
                            <field name="amount_committed" readonly="1"/>
                            <field name="amount_real" readonly="1"/>
                        </group>
                        <group string="Unidades Retributivas (UR)"
                               modifiers="{'invisible': [['type_unit_mode', '=', 'uf']]}">
                            <field name="amount_estimated_uf" readonly="1"/>
                            <field name="amount_committed_uf" readonly="1"/>
                            <field name="amount_real_uf" readonly="1"/>
                        </group>
                        <group string="Unidad Funcional (UF)"
                               modifiers="{'invisible': [['type_unit_mode', '=', 'ur']]}">
                            <field name="amount_estimated_ufunc" readonly="1"/>
                            <field name="amount_committed_ufunc" readonly="1"/>
                            <field name="amount_real_ufunc" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción/Memo" name="description">
                            <field name="description" placeholder="Descripción o memo de la solicitud..." nolabel="1"/>
                        </page>
                        <page string="Líneas" name="lines">
                            <field name="can_create_purchase" invisible="1"/>
                            <button name="action_wizard_create_purchase" type="object"
                                    string="Crear solicitud desde líneas"
                                    class="btn-primary mb-2"
                                    invisible="not can_create_purchase or not line_ids"/>
                            <field name="line_ids" nolabel="1">
                                <list create="1" delete="1" edit="1">
                                    <field name="sequence" widget="handle"/>
                                    <field name="display_type" column_invisible="1"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="recommended_supplier_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Expedientes relacionados" name="children">
                            <field name="parent_id"/>
                            <field name="child_ids" nolabel="1" readonly="1">
                                <list create="1" delete="1" edit="1">
                                    <field name="number"/>
                                    <field name="request_date"/>
                                    <field name="stage_id"/>
                                    <field name="requestor_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Solicitudes de cotización" name="purchases">
                            <field name="can_create_purchase" invisible="1"/>
                            <field name="purchase_order_ids" nolabel="1">
                                <list create="can_create_purchase" delete="0" open="0">
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="date_order"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Facturas" name="invoices">
                            <field name="direct_invoice_ids" nolabel="1"
                                   context="{'default_move_type': 'in_invoice'}">
                                <list create="1" delete="1" open="1">
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="invoice_date"/>
                                    <field name="amount_total"/>
                                    <field name="state"/>
                                    <field name="move_type" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Pagos" name="payments">
                            <field name="payment_ids" nolabel="1">
                                <list create="0" delete="0" open="1">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="partner_id"/>
                                    <field name="amount"/>
                                    <field name="currency_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fund_expedient_search" model="ir.ui.view">
        <field name="name">fund.expedient.search</field>
        <field name="model">fund.expedient</field>
        <field name="arch" type="xml">
            <search string="Buscar expedientes">
                <field name="number"/>
                <field name="description"/>
                <field name="requestor_id"/>
                <field name="recommended_supplier_id"/>
                <field name="budget_position_id"/>
                <field name="encuadre_id"/>
                <field name="type_id"/>
                <field name="project_ids"/>
                <filter string="Mis expedientes" name="my_expedients" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter string="Por aprobar" name="to_approve" domain="[('state', '=', 'to_approve')]"/>
                <filter string="Aprobados" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Cancelados" name="cancelled" domain="[('state', '=', 'cancel')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Etapa" name="group_stage" context="{'group_by': 'stage_id'}"/>
                    <filter string="Solicitante" name="group_requestor" context="{'group_by': 'requestor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fund_expedient" model="ir.actions.act_window">
        <field name="name">Expedientes</field>
        <field name="res_model">fund.expedient</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_fund_expedient_search"/>
        <field name="context">{'search_default_my_expedients': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un expediente
            </p>
            <p>
                Los expedientes permiten gestionar solicitudes con etapas, partida presupuestaria,
                relación con solicitudes de cotización y proyectos.
            </p>
        </field>
    </record>
</odoo>
