<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fund_expedient_spend_request_list" model="ir.ui.view">
        <field name="name">fund.expedient.spend.request.list</field>
        <field name="model">fund.expedient.spend.request</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Solicitudes de Gasto" create="0" delete="0" edit="0">
                <field name="display_name" string="Solicitud"/>
                <field name="expedient_id"/>
                <field name="initial_number"/>
                <field name="initial_date"/>
                <field name="final_number"/>
                <field name="final_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_fund_expedient_spend_request_form" model="ir.ui.view">
        <field name="name">fund.expedient.spend.request.form</field>
        <field name="model">fund.expedient.spend.request</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Solicitud de Gasto">
                <sheet>
                    <group>
                        <field name="expedient_id" readonly="1"/>
                    </group>
                    <group string="Inicial">
                        <group>
                            <field name="initial_number" readonly="1"/>
                            <field name="initial_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="approval_currency_id" invisible="1"/>
                            <field name="initial_amount" readonly="1"/>
                            <field name="initial_amount_unit" readonly="1"/>
                        </group>
                    </group>
                    <group string="Definitiva">
                        <group>
                            <field name="final_number" readonly="1"/>
                            <field name="final_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="final_amount_confirmed" readonly="1"/>
                            <field name="final_amount_confirmed_unit" readonly="1"/>
                        </group>
                    </group>
                    <group string="Líneas">
                        <field name="line_ids" nolabel="1" readonly="1">
                            <list create="0" delete="0" edit="0">
                                <field name="sequence" widget="handle"/>
                                <field name="display_type" column_invisible="1"/>
                                <field name="product_id"/>
                                <field name="name"/>
                                <field name="product_qty"/>
                                <field name="product_uom_id"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fund_expedient_spend_request_pivot" model="ir.ui.view">
        <field name="name">fund.expedient.spend.request.pivot</field>
        <field name="model">fund.expedient.spend.request</field>
        <field name="type">pivot</field>
        <field name="arch" type="xml">
            <pivot string="Solicitudes de Gasto - Análisis">
                <field name="expedient_id" type="row"/>
                <field name="initial_date" interval="month" type="col"/>
                <field name="id" type="measure" string="Cantidad"/>
            </pivot>
        </field>
    </record>
</odoo>

