<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_expedient" model="ir.ui.view">
        <field name="name">account.move.form.expedient</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="expedient_ids" widget="many2many_tags"
                       options="{'no_create': True}"
                       invisible="move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
