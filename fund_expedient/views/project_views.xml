<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_form_expedient" model="ir.ui.view">
        <field name="name">project.project.form.expedient</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <!-- Añadir botón de expedientes: intentar dentro de button_box si existe -->
            <xpath expr="//div[contains(@class, 'oe_button_box')]" position="inside">
                <button name="action_view_expedients" type="object"
                        class="oe_stat_button" icon="fa-folder-open">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="expedient_count"/></span>
                        <span class="o_stat_text">Expedientes</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
