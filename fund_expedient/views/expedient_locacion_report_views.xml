<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Reporte 1: Detalle de contratación (Locación de Servicios/Obra)
         Sobre fund.expedient.line, filtrado a expedientes de locación.
         Muestra cantidad, UM, precios, fechas, proveedor contratado (OC)
         y las facturas reales del expediente.
         ============================================================ -->
    <record id="view_expedient_locacion_line_list" model="ir.ui.view">
        <field name="name">fund.expedient.line.locacion.list</field>
        <field name="model">fund.expedient.line</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Contrataciones (Locación)" create="0" delete="0" edit="0">
                <field name="expedient_id"/>
                <field name="contract_kind"/>
                <field name="product_id"/>
                <field name="name" string="Descripción"/>
                <field name="product_qty" string="Cantidad"/>
                <field name="product_uom_id" string="UM"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="price_unit_final" string="Precio unitario"/>
                <field name="amount_final_line" string="Precio total" sum="Total"/>
                <field name="price_unit_estimated" string="P. unitario est." optional="hide"/>
                <field name="amount_estimated_line" string="Total estimado" optional="hide"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="contracted_supplier_ids" widget="many2many_tags" string="Proveedor (OC)"/>
                <!-- Total del expediente, no de la línea: no se suma (ver help del campo). -->
                <field name="expedient_amount_real" string="Facturas reales (expediente)"/>
                <field name="analytic_account_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_expedient_locacion_line_pivot" model="ir.ui.view">
        <field name="name">fund.expedient.line.locacion.pivot</field>
        <field name="model">fund.expedient.line</field>
        <field name="type">pivot</field>
        <field name="arch" type="xml">
            <pivot string="Contrataciones (Locación) - Análisis">
                <field name="expedient_id" type="row"/>
                <field name="contract_kind" type="col"/>
                <field name="amount_estimated_line" type="measure"/>
                <field name="amount_final_line" type="measure"/>
                <field name="product_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_expedient_locacion_line_search" model="ir.ui.view">
        <field name="name">fund.expedient.line.locacion.search</field>
        <field name="model">fund.expedient.line</field>
        <field name="arch" type="xml">
            <search string="Buscar contrataciones">
                <field name="expedient_id"/>
                <field name="product_id"/>
                <field name="name" string="Descripción"/>
                <field name="analytic_account_id"/>
                <filter string="Locación de Servicios" name="service_lease"
                        domain="[('contract_kind', '=', 'service_lease')]"/>
                <filter string="Locación de Obra" name="work_lease"
                        domain="[('contract_kind', '=', 'work_lease')]"/>
                <separator/>
                <filter string="Con fechas cargadas" name="with_dates"
                        domain="[('date_start', '!=', False), ('date_end', '!=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Expediente" name="group_expedient"
                            context="{'group_by': 'expedient_id'}"/>
                    <filter string="Tipo de locación" name="group_contract_kind"
                            context="{'group_by': 'contract_kind'}"/>
                    <filter string="Cuenta analítica" name="group_analytic"
                            context="{'group_by': 'analytic_account_id'}"/>
                    <filter string="Fecha inicio" name="group_date_start"
                            context="{'group_by': 'date_start:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_expedient_locacion_contrataciones" model="ir.actions.act_window">
        <field name="name">Contrataciones (Locación)</field>
        <field name="res_model">fund.expedient.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="view_id" ref="view_expedient_locacion_line_list"/>
        <field name="search_view_id" ref="view_expedient_locacion_line_search"/>
        <field name="domain">[('contract_kind', 'in', ('service_lease', 'work_lease')), ('display_type', '=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Contrataciones de Locación de Servicios y de Obra
            </p>
            <p>
                Se listan las líneas de expedientes marcados como Locación, con cantidad, unidad,
                precios, fechas de inicio/fin, el proveedor contratado (según la orden de compra)
                y el total real facturado del expediente.
            </p>
        </field>
    </record>

    <!-- ============================================================
         Reporte 2: Proyección mensual de flujo de caja (Locación)
         Sobre la vista SQL fund.expedient.contract.projection.
         ============================================================ -->
    <record id="view_expedient_locacion_projection_pivot" model="ir.ui.view">
        <field name="name">fund.expedient.contract.projection.pivot</field>
        <field name="model">fund.expedient.contract.projection</field>
        <field name="type">pivot</field>
        <field name="arch" type="xml">
            <pivot string="Proyección mensual (Locación)">
                <field name="expedient_id" type="row"/>
                <field name="partner_id" type="row"/>
                <field name="month" interval="month" type="col"/>
                <field name="amount_month" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_expedient_locacion_projection_list" model="ir.ui.view">
        <field name="name">fund.expedient.contract.projection.list</field>
        <field name="model">fund.expedient.contract.projection</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Proyección mensual (Locación)" create="0" delete="0" edit="0">
                <field name="expedient_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="contract_kind"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="month_count"/>
                <field name="amount_total" sum="Total contratado"/>
                <field name="month"/>
                <field name="amount_month" sum="Total del período"/>
                <field name="analytic_account_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_expedient_locacion_projection_search" model="ir.ui.view">
        <field name="name">fund.expedient.contract.projection.search</field>
        <field name="model">fund.expedient.contract.projection</field>
        <field name="arch" type="xml">
            <search string="Buscar proyección">
                <field name="expedient_id"/>
                <field name="partner_id"/>
                <field name="analytic_account_id"/>
                <filter string="Locación de Servicios" name="service_lease"
                        domain="[('contract_kind', '=', 'service_lease')]"/>
                <filter string="Locación de Obra" name="work_lease"
                        domain="[('contract_kind', '=', 'work_lease')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Expediente" name="group_expedient"
                            context="{'group_by': 'expedient_id'}"/>
                    <filter string="Proveedor" name="group_partner"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Cuenta analítica" name="group_analytic"
                            context="{'group_by': 'analytic_account_id'}"/>
                    <filter string="Mes" name="group_month"
                            context="{'group_by': 'month:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_expedient_locacion_projection" model="ir.actions.act_window">
        <field name="name">Proyección de Locación</field>
        <field name="res_model">fund.expedient.contract.projection</field>
        <field name="view_mode">pivot,list</field>
        <field name="view_id" ref="view_expedient_locacion_projection_pivot"/>
        <field name="search_view_id" ref="view_expedient_locacion_projection_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Proyección mensual de flujo de caja (Locación)
            </p>
            <p>
                El importe total de cada línea contratada se reparte en partes iguales entre los
                meses del período (Fecha inicio a Fecha fin). Use la vista <b>Pivote</b> para ver
                el flujo mensual por expediente y proveedor.
            </p>
        </field>
    </record>

</odoo>
