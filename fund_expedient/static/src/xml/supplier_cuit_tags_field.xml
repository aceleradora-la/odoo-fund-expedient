<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="fund_expedient.SupplierCuitTagsField">
        <div class="o_field_tags d-inline-flex flex-wrap align-items-center gap-1 w-100">
            <TagsList tags="tags"/>
            <t t-if="!props.readonly">
                <input type="text"
                       class="o_input fund_cuit_input flex-grow-1"
                       t-ref="cuitInput"
                       placeholder="Escribí el CUIT del proveedor"
                       autocomplete="off"
                       t-att-disabled="state.busy"
                       t-on-input="onInput"
                       t-on-keydown="onKeydown"/>
            </t>
        </div>
        <div t-if="state.candidate and !props.readonly"
             class="d-flex align-items-center gap-2 mt-1 p-2 border rounded bg-light fund_cuit_candidate">
            <div class="flex-grow-1 text-truncate">
                <i class="fa fa-building-o me-1 text-muted"/>
                <strong t-esc="state.candidate.display_name"/>
                <small class="text-muted ms-2" t-esc="state.candidate.vat"/>
            </div>
            <button type="button" class="btn btn-primary btn-sm" t-on-click="onConfirm">Agregar</button>
            <button type="button" class="btn btn-link btn-sm text-muted" t-on-click="onDiscard">Descartar</button>
        </div>
        <div t-if="state.message" class="small mt-1" t-att-class="messageClass">
            <span t-esc="state.message"/>
            <a t-if="state.canCreate and !props.readonly" href="#" class="ms-2 fw-bold"
               t-on-click="onCreate">
                <i class="fa fa-cloud-download me-1"/>Crear desde ARCA y agregar
            </a>
        </div>
    </t>

</templates>
