<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tarjeta en /my -->
    <template id="portal_my_home_expedient" name="Portal My Home: Expedientes" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/fund_expedient_portal/static/src/img/expedient.svg'"/>
                <t t-set="title">Expedientes</t>
                <t t-set="url" t-value="'/my/expedients'"/>
                <t t-set="text">Consulte y gestione sus expedientes</t>
                <t t-set="placeholder_count" t-value="'expedient_count'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <!-- Listado -->
    <template id="portal_my_expedients" name="Mis expedientes">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Expedientes</t>
            </t>

            <t t-if="not expedients">
                <p class="alert alert-warning mt-3" role="alert">
                    No hay expedientes que mostrar.
                </p>
            </t>
            <t t-if="expedients" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Número</th>
                        <th>Tipo</th>
                        <th>Etapa</th>
                        <th>Fecha solicitud</th>
                        <th>Solicitante</th>
                        <th>En poder de</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="expedients" t-as="exp">
                        <td>
                            <a t-att-href="exp.get_portal_url()">
                                <t t-esc="exp.number or exp.id"/>
                            </a>
                        </td>
                        <td><t t-esc="exp.type_id.name or ''"/></td>
                        <td><span class="badge text-bg-secondary" t-esc="exp.stage_id.name or ''"/></td>
                        <td><span t-field="exp.request_date"/></td>
                        <td><t t-esc="exp.requestor_id.name or ''"/></td>
                        <td>
                            <t t-if="exp.holder_reason in ('expedient_approval', 'spend_request_approval')">
                                <span class="badge text-bg-warning">Esperando aprobación</span>
                            </t>
                            <t t-foreach="exp.holder_user_ids[:3]" t-as="holder">
                                <span class="badge text-bg-light" t-esc="holder.name"/>
                            </t>
                            <span t-if="len(exp.holder_user_ids) > 3" class="text-muted small">
                                +<t t-esc="len(exp.holder_user_ids) - 3"/>
                            </span>
                        </td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>

    <!-- Detalle -->
    <template id="portal_expedient_page" name="Expediente portal">
        <t t-call="portal.portal_layout">
            <t t-set="o_portal_fullwidth_alert" groups="base.group_user">
                <t t-call="portal.portal_back_in_edit_mode">
                    <t t-set="backend_url" t-value="'/web#model=fund.expedient&amp;id=%s&amp;view_type=form' % expedient.id"/>
                </t>
            </t>

            <div class="o_portal_expedient_detail container mt-3 mb-5">
                <t t-if="portal_flash">
                    <div t-attf-class="alert alert-#{portal_flash.get('type', 'danger')} o_portal_expedient_flash" role="alert">
                        <t t-esc="portal_flash.get('message')"/>
                    </div>
                </t>

                <div class="row mb-3">
                    <div class="col-12">
                        <h2 class="mb-2">
                            Expediente <span t-esc="expedient.number or expedient.id"/>
                        </h2>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge text-bg-primary" t-esc="expedient.stage_id.name or 'Sin etapa'"/>
                            <span t-if="expedient_state_label" class="badge text-bg-secondary" t-esc="expedient_state_label"/>
                            <span class="badge text-bg-light" t-if="expedient.type_number" t-esc="expedient.type_number"/>
                            <span class="badge text-bg-light" t-if="expedient.parent_id">
                                Hijo de <t t-esc="expedient.parent_id.number"/>
                            </span>
                        </div>
                    </div>
                </div>

                <!--
                    Carteles de situación: los mismos dos del backend. Quién tiene
                    el expediente ahora (amarillo si espera aprobación, azul si
                    está en manos de la etapa) y, para quien opera la etapa, qué
                    falta para poder avanzar.
                -->
                <t t-if="expedient.holder_summary">
                    <div t-attf-class="alert #{'alert-warning' if expedient.holder_reason in ('expedient_approval', 'spend_request_approval') else 'alert-info'} d-flex align-items-center" role="alert">
                        <i t-attf-class="fa #{'fa-hourglass-half' if expedient.holder_reason in ('expedient_approval', 'spend_request_approval') else 'fa-user'} me-2"/>
                        <span t-esc="expedient.holder_summary"/>
                    </div>
                </t>
                <t t-if="portal_can_operate and expedient.stage_requirements_pending">
                    <div class="alert alert-secondary d-flex align-items-center" role="alert">
                        <i class="fa fa-list-ul me-2"/>
                        <span t-esc="expedient.stage_requirements_pending"/>
                    </div>
                </t>

                <div class="row mb-4">
                    <div class="col-lg-8">
                        <div class="card mb-3">
                            <div class="card-header">Datos generales</div>
                            <div class="card-body">
                                <dl class="row expedient-meta mb-0">
                                    <dt class="col-sm-4">Tipo</dt>
                                    <dd class="col-sm-8"><t t-esc="expedient.type_id.name or ''"/></dd>

                                    <dt class="col-sm-4">Solicitante</dt>
                                    <dd class="col-sm-8"><t t-esc="expedient.requestor_id.name or ''"/></dd>

                                    <dt class="col-sm-4" t-if="expedient.requestor_department_id">Sector requirente</dt>
                                    <dd class="col-sm-8" t-if="expedient.requestor_department_id">
                                        <t t-esc="expedient.requestor_department_id.name"/>
                                    </dd>

                                    <dt class="col-sm-4" t-if="expedient.requestor_department_manager_id">Responsable del sector</dt>
                                    <dd class="col-sm-8" t-if="expedient.requestor_department_manager_id">
                                        <t t-esc="expedient.requestor_department_manager_id.name"/>
                                    </dd>

                                    <dt class="col-sm-4" t-if="expedient.company_id">Compañía</dt>
                                    <dd class="col-sm-8" t-if="expedient.company_id">
                                        <t t-esc="expedient.company_id.name"/>
                                    </dd>

                                    <dt class="col-sm-4">Fecha solicitud</dt>
                                    <dd class="col-sm-8"><span t-field="expedient.request_date"/></dd>

                                    <dt class="col-sm-4">Fecha estimada necesidad</dt>
                                    <dd class="col-sm-8">
                                        <span t-if="expedient.estimated_need_date" t-field="expedient.estimated_need_date"/>
                                        <t t-else="">—</t>
                                    </dd>

                                    <dt class="col-sm-4" t-if="expedient.encuadre_id">Encuadre</dt>
                                    <dd class="col-sm-8" t-if="expedient.encuadre_id">
                                        <t t-esc="expedient.encuadre_id.name"/>
                                    </dd>

                                    <dt class="col-sm-4" t-if="expedient.analytic_account_id">Cuenta analítica</dt>
                                    <dd class="col-sm-8" t-if="expedient.analytic_account_id">
                                        <t t-esc="expedient.analytic_account_id.display_name"/>
                                    </dd>

                                    <dt class="col-sm-4" t-if="expedient.recommended_supplier_ids">Proveedores recomendados</dt>
                                    <dd class="col-sm-8" t-if="expedient.recommended_supplier_ids">
                                        <t t-foreach="expedient.recommended_supplier_ids" t-as="supplier">
                                            <span class="badge text-bg-light me-1 mb-1" t-esc="supplier.name"/>
                                        </t>
                                    </dd>

                                    <dt class="col-sm-4" t-if="expedient.contract_object">Objeto</dt>
                                    <dd class="col-sm-8" t-if="expedient.contract_object">
                                        <t t-esc="expedient.contract_object"/>
                                    </dd>

                                    <dt class="col-sm-4" t-if="expedient.delivery_location">Lugar de Entrega/Ejecución</dt>
                                    <dd class="col-sm-8" t-if="expedient.delivery_location">
                                        <t t-esc="expedient.delivery_location"/>
                                    </dd>

                                    <dt class="col-sm-4" t-if="expedient.child_ids">Expedientes relacionados</dt>
                                    <dd class="col-sm-8" t-if="expedient.child_ids">
                                        <t t-foreach="expedient.child_ids" t-as="child">
                                            <a t-att-href="child.get_portal_url()" class="badge text-bg-light text-decoration-none me-1 mb-1" t-esc="child.number"/>
                                        </t>
                                    </dd>
                                </dl>
                            </div>
                        </div>

                        <div class="card mb-3" t-if="expedient.description or expedient.description_plain">
                            <div class="card-header">Descripción</div>
                            <div class="card-body">
                                <div t-if="expedient.description" t-field="expedient.description"/>
                                <p t-else="" class="mb-0 text-muted" t-esc="expedient.description_plain"/>
                            </div>
                        </div>

                        <div class="card mb-3">
                            <div class="card-header">Importes</div>
                            <div class="card-body p-0">
                                <table class="table table-sm mb-0 o_portal_expedient_amounts">
                                    <tbody>
                                        <tr>
                                            <th>Estimado</th>
                                            <td class="text-end">
                                                <span t-field="expedient.amount_estimated" t-options="{'widget': 'monetary', 'display_currency': expedient.currency_id}"/>
                                            </td>
                                        </tr>
                                        <tr t-if="expedient.amount_estimated_confirmed">
                                            <th>Definitivo confirmado</th>
                                            <td class="text-end">
                                                <span t-field="expedient.amount_estimated_confirmed" t-options="{'widget': 'monetary', 'display_currency': expedient.currency_id}"/>
                                            </td>
                                        </tr>
                                        <tr t-if="expedient.amount_committed">
                                            <th>Comprometido</th>
                                            <td class="text-end">
                                                <span t-field="expedient.amount_committed" t-options="{'widget': 'monetary', 'display_currency': expedient.currency_id}"/>
                                            </td>
                                        </tr>
                                        <tr t-if="expedient.amount_real">
                                            <th>Real</th>
                                            <td class="text-end">
                                                <span t-field="expedient.amount_real" t-options="{'widget': 'monetary', 'display_currency': expedient.currency_id}"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="card mb-3" t-if="expedient.line_ids">
                            <div class="card-header">Líneas del expediente</div>
                            <div class="card-body p-0 table-responsive">
                                <table class="table table-sm table-striped mb-0">
                                    <thead>
                                        <tr>
                                            <th>Descripción</th>
                                            <th class="text-end">Cant.</th>
                                            <th class="text-end">Importe est.</th>
                                            <th class="text-end">Importe def.</th>
                                            <th t-if="is_lease">Inicio</th>
                                            <th t-if="is_lease">Fin</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="expedient.line_ids" t-as="line">
                                            <td>
                                                <t t-if="line.display_type == 'line_section'">
                                                    <strong t-esc="line.name"/>
                                                </t>
                                                <t t-elif="line.display_type == 'line_note'">
                                                    <em t-esc="line.name"/>
                                                </t>
                                                <t t-else="">
                                                    <t t-esc="line.name or line.product_id.display_name"/>
                                                </t>
                                            </td>
                                            <td class="text-end">
                                                <t t-if="not line.display_type" t-esc="line.product_qty"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-if="not line.display_type">
                                                    <span t-field="line.amount_estimated_line" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                                </t>
                                            </td>
                                            <td class="text-end">
                                                <t t-if="not line.display_type and line.amount_final_line">
                                                    <span t-field="line.amount_final_line" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                                </t>
                                            </td>
                                            <td t-if="is_lease"><span t-if="line.date_start" t-field="line.date_start"/></td>
                                            <td t-if="is_lease"><span t-if="line.date_end" t-field="line.date_end"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="card mb-3" id="spend_requests" t-if="expedient_spend_requests or portal_can_create_sr_preventiva or portal_can_create_sr_final">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span>Solicitudes de <t t-esc="'ingreso' if expedient.operation_type == 'income' else 'gasto'"/></span>
                                <!-- Generar la Solicitud desde el portal: misma disponibilidad que los botones del backend. -->
                                <div class="d-flex gap-2">
                                    <form t-if="portal_can_create_sr_preventiva" t-att-action="'/my/expedients/%s/spend_request/preventiva' % expedient.id" method="POST">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">
                                            Generar preventiva
                                        </button>
                                    </form>
                                    <form t-if="portal_can_create_sr_final" t-att-action="'/my/expedients/%s/spend_request/definitiva' % expedient.id" method="POST">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">
                                            Generar definitiva
                                        </button>
                                    </form>
                                </div>
                            </div>
                            <div class="card-body p-0 table-responsive" t-if="expedient_spend_requests">
                                <table class="table table-sm mb-0">
                                    <thead>
                                        <tr>
                                            <th>Solicitud</th>
                                            <th>Preventiva</th>
                                            <th>Definitiva</th>
                                            <th class="text-end">Monto prev.</th>
                                            <th class="text-end">Monto def.</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="expedient_spend_requests" t-as="sg" t-att-class="'text-muted' if sg.cancelled else ''">
                                            <td>
                                                <a t-if="not sg.cancelled" t-att-href="'#sg_%s' % sg.id" t-esc="sg.display_name"/>
                                                <t t-else="" t-esc="sg.display_name"/>
                                            </td>
                                            <td><span t-field="sg.preventiva_state"/></td>
                                            <td><span t-field="sg.definitiva_state"/></td>
                                            <td class="text-end">
                                                <span t-field="sg.amount_preventiva" t-options="{'widget': 'monetary', 'display_currency': sg.currency_id}"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="sg.amount_definitiva" t-options="{'widget': 'monetary', 'display_currency': sg.currency_id}"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!--
                            Documentos por etapa: consulta para todos, carga para quien
                            opera la etapa actual. La descarga pasa por /web/content con
                            el usuario real (ACL + regla de registro del portal).
                        -->
                        <div class="card mb-3" id="documents" t-if="expedient_documents or portal_can_operate">
                            <div class="card-header">Documentos</div>
                            <div class="card-body p-0 table-responsive" t-if="expedient_documents">
                                <table class="table table-sm mb-0">
                                    <thead>
                                        <tr>
                                            <th>Nº</th>
                                            <th>Documento</th>
                                            <th>Tipo</th>
                                            <th>Etapa</th>
                                            <th>Archivo</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="expedient_documents" t-as="doc">
                                            <td><t t-esc="doc.number or ''"/></td>
                                            <td><t t-esc="doc.name or ''"/></td>
                                            <td><t t-esc="doc.document_type_id.name or ''"/></td>
                                            <td><t t-esc="doc.stage_id.name or ''"/></td>
                                            <td>
                                                <a t-if="doc.file_data"
                                                   t-att-href="'/web/content?model=fund.expedient.document&amp;id=%s&amp;field=file_data&amp;filename_field=file_name&amp;download=true' % doc.id">
                                                    <i class="fa fa-download me-1"/><t t-esc="doc.file_name or 'Descargar'"/>
                                                </a>
                                                <span t-else="" class="text-muted">Sin archivo</span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="card-body border-top" t-if="portal_can_operate">
                                <p t-if="portal_required_document_types" class="small text-muted mb-2">
                                    Tipos exigidos en esta etapa que todavía faltan:
                                    <t t-foreach="portal_required_document_types" t-as="dtype">
                                        <span class="badge text-bg-warning" t-esc="dtype.name"/>
                                    </t>
                                </p>
                                <form t-att-action="'/my/expedients/%s/documents/upload' % expedient.id" method="POST" enctype="multipart/form-data" class="row g-2 align-items-end">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="col-md-4">
                                        <label class="form-label small mb-1">Archivo</label>
                                        <input type="file" name="file" class="form-control form-control-sm" required="required"/>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small mb-1">Tipo de documento</label>
                                        <select name="document_type_id" class="form-select form-select-sm">
                                            <option value="">— Sin tipo —</option>
                                            <t t-foreach="document_types" t-as="dtype">
                                                <option t-att-value="dtype.id" t-esc="dtype.name"/>
                                            </t>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small mb-1">Nombre (opcional)</label>
                                        <input type="text" name="name" class="form-control form-control-sm" placeholder="Igual al archivo si se deja vacío"/>
                                    </div>
                                    <div class="col-md-2">
                                        <button type="submit" class="btn btn-sm btn-primary w-100">Subir</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <div class="row" t-if="expedient.disposition_ids or expedient.resolution_ids">
                            <div class="col-md-6 mb-3" t-if="expedient.disposition_ids">
                                <div class="card h-100">
                                    <div class="card-header">Disposiciones</div>
                                    <ul class="list-group list-group-flush">
                                        <li t-foreach="expedient.disposition_ids" t-as="disp" class="list-group-item">
                                            <a t-att-href="'#disp_%s' % disp.id">
                                                <t t-esc="disp.number or disp.name or disp.id"/>
                                            </a>
                                            <span t-if="disp.cancelled" class="badge text-bg-danger ms-1">Anulada</span>
                                            <small class="text-muted d-block" t-esc="disp.stage_id.name"/>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3" t-if="expedient.resolution_ids">
                                <div class="card h-100">
                                    <div class="card-header">Resoluciones</div>
                                    <ul class="list-group list-group-flush">
                                        <li t-foreach="expedient.resolution_ids" t-as="resol" class="list-group-item">
                                            <a t-att-href="'#resol_%s' % resol.id">
                                                <t t-esc="resol.number or resol.name or resol.id"/>
                                            </a>
                                            <span t-if="resol.cancelled" class="badge text-bg-danger ms-1">Anulada</span>
                                            <small class="text-muted d-block" t-esc="resol.stage_id.name"/>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="card mb-3" t-if="portal_stage_show_panel">
                            <div class="card-header">Etapa</div>
                            <div class="card-body d-grid gap-2">
                                <t t-if="portal_can_previous">
                                    <form t-att-action="'/my/expedients/%s/previous_stage' % expedient.id" method="POST">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-outline-secondary w-100">
                                            Etapa anterior
                                        </button>
                                    </form>
                                </t>
                                <t t-else="">
                                    <button type="button" class="btn btn-outline-secondary w-100" disabled="disabled">
                                        Etapa anterior
                                    </button>
                                    <p t-if="portal_block_previous" class="small text-muted mb-0" t-esc="portal_block_previous"/>
                                </t>

                                <t t-if="portal_can_next">
                                    <form t-att-action="'/my/expedients/%s/next_stage' % expedient.id" method="POST">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-primary w-100">
                                            Siguiente etapa
                                        </button>
                                    </form>
                                </t>
                                <t t-else="">
                                    <button type="button" class="btn btn-primary w-100" disabled="disabled">
                                        Siguiente etapa
                                    </button>
                                    <p t-if="portal_block_next" class="small text-muted mb-0" t-esc="portal_block_next"/>
                                </t>
                            </div>
                        </div>
                        <div class="card mb-3">
                            <div class="card-header">Accesos rápidos</div>
                            <div class="card-body d-grid gap-2">
                                <!-- Enlace a aprobaciones: lo agrega el módulo de validación por niveles. -->
                                <div id="portal_expedient_quick_links"/>
                                <a href="/my/expedients" class="btn btn-outline-secondary btn-sm">
                                    Volver al listado
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Panel tier: fund_expedient_tier_validation_portal -->
                <div id="portal_expedient_tier_panel"/>
            </div>
        </t>
    </template>

</odoo>
