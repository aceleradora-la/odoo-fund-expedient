<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fund_expedient_budget_report_search" model="ir.ui.view">
        <field name="name">fund.expedient.budget.report.search</field>
        <field name="model">fund.expedient.budget.report</field>
        <field name="arch" type="xml">
            <search string="Ejecución presupuestaria">
                <!-- Puede haber varias versiones del presupuesto: se elige acá. -->
                <field name="budget_analytic_id"/>
                <field name="analytic_account_id"/>
                <filter string="Gasto" name="expense" domain="[('operation_type', '=', 'expense')]"/>
                <filter string="Ingreso" name="income" domain="[('operation_type', '=', 'income')]"/>
                <separator/>
                <filter string="Con presupuesto" name="with_budget" domain="[('amount_budget', '&gt;', 0)]"/>
                <filter string="Con movimientos" name="with_execution"
                        domain="['|', ('amount_committed', '!=', 0), ('amount_real', '!=', 0)]"/>
                <filter string="Excedidos" name="exceeded" domain="[('amount_balance', '&lt;', 0)]"/>
                <separator/>
                <filter string="Presupuestos vigentes" name="current_budgets"
                        domain="[('budget_state', 'in', ('draft', 'confirmed'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Presupuesto" name="group_budget"
                            context="{'group_by': 'budget_analytic_id'}"/>
                    <filter string="Cuenta analítica" name="group_analytic"
                            context="{'group_by': 'analytic_account_id'}"/>
                    <filter string="Operación" name="group_operation"
                            context="{'group_by': 'operation_type'}"/>
                    <filter string="Estado del presupuesto" name="group_state"
                            context="{'group_by': 'budget_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_fund_expedient_budget_report_list" model="ir.ui.view">
        <field name="name">fund.expedient.budget.report.list</field>
        <field name="model">fund.expedient.budget.report</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Ejecución presupuestaria" create="0" delete="0" edit="0"
                  decoration-danger="amount_balance &lt; 0"
                  decoration-muted="amount_budget == 0 and amount_committed == 0 and amount_real == 0">
                <field name="currency_id" column_invisible="1"/>
                <field name="budget_analytic_id" optional="show"/>
                <field name="budget_state" optional="hide"/>
                <field name="analytic_account_id"/>
                <field name="operation_type" optional="show"/>
                <field name="amount_budget" sum="Total presupuesto"/>
                <field name="amount_committed" sum="Total comprometido"/>
                <field name="amount_real" sum="Total real"/>
                <field name="amount_balance" sum="Total disponible"/>
                <field name="percent_executed" widget="progressbar" optional="show"/>
                <field name="expedient_count" optional="show"/>
                <button name="action_open_expedients" type="object" string="Expedientes"
                        icon="fa-folder-open-o" class="btn-link" invisible="not expedient_count"/>
            </list>
        </field>
    </record>

    <record id="view_fund_expedient_budget_report_pivot" model="ir.ui.view">
        <field name="name">fund.expedient.budget.report.pivot</field>
        <field name="model">fund.expedient.budget.report</field>
        <field name="type">pivot</field>
        <field name="arch" type="xml">
            <pivot string="Ejecución presupuestaria" disable_linking="1">
                <field name="budget_analytic_id" type="row"/>
                <field name="analytic_account_id" type="row"/>
                <field name="amount_budget" type="measure"/>
                <field name="amount_committed" type="measure"/>
                <field name="amount_real" type="measure"/>
                <field name="amount_balance" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_fund_expedient_budget_report_graph" model="ir.ui.view">
        <field name="name">fund.expedient.budget.report.graph</field>
        <field name="model">fund.expedient.budget.report</field>
        <field name="type">graph</field>
        <field name="arch" type="xml">
            <graph string="Ejecución presupuestaria" type="bar" stacked="0">
                <field name="analytic_account_id"/>
                <field name="amount_budget" type="measure"/>
                <field name="amount_committed" type="measure"/>
                <field name="amount_real" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_fund_expedient_budget_report" model="ir.actions.act_window">
        <field name="name">Ejecución presupuestaria</field>
        <field name="res_model">fund.expedient.budget.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_fund_expedient_budget_report_search"/>
        <field name="context">{'search_default_current_budgets': 1, 'search_default_group_budget': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Todavía no hay presupuestos para comparar
            </p>
            <p>
                Cargue un presupuesto analítico en Contabilidad › Presupuestos. Por cada
                cuenta analítica se muestra el presupuesto, lo comprometido en órdenes de
                compra, lo facturado y el disponible, según los expedientes de esa cuenta.
            </p>
        </field>
    </record>

    <menuitem id="menu_fund_expedient_budget_report"
              name="Ejecución presupuestaria"
              parent="fund_expedient.menu_fund_budget_root"
              action="action_fund_expedient_budget_report"
              sequence="10"/>
</odoo>
