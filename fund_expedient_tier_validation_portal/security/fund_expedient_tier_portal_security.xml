<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="fund_expedient_tier_review_portal_rule" model="ir.rule">
            <field name="name">Tier review portal: revisor asignado</field>
            <field name="model_id" ref="base_tier_validation.model_tier_review"/>
            <field name="domain_force">[('reviewer_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
        <!-- Revisores tier externos: acceso al expediente padre -->
        <record id="fund_expedient_portal_partner_reviewer_rule" model="ir.rule">
            <field name="name">Expediente portal: revisor tier</field>
            <field name="model_id" ref="fund_expedient.model_fund_expedient"/>
            <field name="domain_force">[('review_ids.reviewer_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
    </data>
</odoo>
